// GRmail /admin/settings 全量配置页（U10：Q3-C 归属+Q7-C 四节范围——认证栈/catch-all/
// 邮件限值/会话与限流；保存经 SaveConfig 原子读改写→热加载生效——流程设计第五章；
// U13 增传输安全节——MTA-STS/TLS-RPT 开关与参数+DNS 建议值只读区，FR-010 判定③
// 「Web 关闭即端点停发」的配置载体；U18 深级双语收口——U16 登记项③：全部深级文案 Tr 化）。
// CSRF：认证会话表单埋 csrf_token 隐藏域（U8 csrfProtect 常数时间比对）。
// F01 骨架统一（Webmail界面精修批次 2026-10-03 16:30:00）：Layout→AppLayout（admin 主体）
// +.main content-page 容器（对齐 admin/tokens 形态）+Message/Notice 分型（错误 .error/
// 成功 .notice）+删除底部旧导航 hint。
// 修改历史：
//   2026-09-20 01:26:00 | 新建 | U10 Setup 向导与 ACME（计划书步骤 7）
//   2026-09-23 08:46:00 | 扩展 | U13 传输安全全量：传输安全节（计划书步骤 4；契约 v1.9.0 3.3）
//   2026-09-26 15:52:00 | 扩展 | U18 登记项收尾：深级文案 Tr 化（settings 域键全量接线——
//   U16 已埋 legend 键本单元消费+label 键族增补；缺省 zh 渲染与 U17 末态零变化锚）
//   （依据：U18 计划书 v1.0.0 步骤 3/1.5④，G2 批准 2026-09-26 15:25:47）
//   2026-10-03 16:30:00 | 重构 | Webmail界面精修批次 F01（G2 批准 2026-10-03 16:22:31）
//   2026-10-15 00:40:00 | 修正 | Webmail前端可见性一致性令牌批 β A2：四处 size
//   物理宽属性删除（40/40/16/32——窄屏溢出收口；弹性宽经 app.css fieldset 规则承载）
//   （依据：β批计划书 v1.0.0 1.2 A2，G2 批准 2026-10-15 00:12）
//   2026-10-15 01:35:00 | 重构 | Webmail前端可选交互增强批 γ（G2 批准 2026-10-15 01:22
//   三组候选全 A）：B5/E-1-A 分区提交——四可编辑节各自独立表单（section 隐藏域分派，
//   仅校验+保存本节；未提交节保留现值；「一次保存全部五节」批量交互移除——计划书 1.3
//   已披露获批）+C3/E-2-A 组件化——枢纽导航抽 settingsNavHub、返回链抽 settingsNavBack
//   （三形态语义保持，批二 F7 双分支语义参数化）+E2/E-3-A 分组折叠——details 默认全展开
//   （<768 可折叠；≥768 summary 禁交互恒展开——桌面呈现零变化锚，app.css .settings-fold 承载）
package templates

import "fmt"

// settingsNavHub 管理枢纽导航（C3/E-2-A γ批：/admin/settings 页首八项——服务配置
// active+七链；自本版起为共享组件，本页为唯一枢纽形态消费点）。
// 参数：lang 界面语言。
templ settingsNavHub(lang Lang) {
	<nav class="settings-nav" aria-label={ Tr(lang, "settings.navTitle") }>
		<span class="active">{ Tr(lang, "settings.navService") }</span>
		<a href="/admin/mailboxes">{ Tr(lang, "settings.navMailboxes") }</a>
		<a href="/admin/mailboxes/unregistered">{ Tr(lang, "settings.navAggregate") }</a>
		<a href="/admin/tokens">{ Tr(lang, "settings.navTokens") }</a>
		<a href="/admin/plugins">{ Tr(lang, "settings.navPlugins") }</a>
		<a href="/sieve">{ Tr(lang, "hub.rules") }</a>
		<a href="/admin/password">{ Tr(lang, "settings.navAdminPw") }</a>
	</nav>
}

// settingsNavBack 设置族子页返回导航（C3/E-2-A γ批：三形态统一组件——admin 直达
// /admin/settings、mailbox 经 /settings〔批二 F7「admin 直达省一跳」裁决语义保持〕；
// aria-label 统一承载——admin 既有形态拉平，plugins/tokens/sieve/password 四页可访问名
// 增益，视觉零变化）。
// 参数：lang 界面语言；isAdmin 主体标记（true=admin 形态单链直达）。
templ settingsNavBack(lang Lang, isAdmin bool) {
	<nav class="settings-nav" aria-label={ Tr(lang, "settings.navTitle") }>
		if isAdmin {
			<a href="/admin/settings">{ Tr(lang, "nav.backSettings") }</a>
		} else {
			<a href="/settings">{ Tr(lang, "nav.backSettings") }</a>
		}
	</nav>
}

// SettingsView 设置页（B5/E-1-A γ批：四可编辑节独立表单分区提交——每节埋 section
// 隐藏域（auth/delivery/session/tls）+节尾独立保存钮；仅校验+保存被提交节，未提交节
// 保留现值〔SaveConfig 读改写基底〕；DNS 建议节只读无表单。E2/E-3-A：details 分组
// 折叠默认全展开——移动端可收起，桌面恒展开。当前值回填）。
// 参数：data 设置数据（SettingsData——web 包 buildSettingsData 装配；Lang 承载界面语言）。
templ SettingsView(data SettingsData) {
	{{ lang := NormalizeLang(data.Lang) }}
	@appLayoutSettings(lang, data.CSRFToken, data.Nav) {
		<main class="main content-page" id="main-content">
		<div class="page-head"><h2>{ Tr(lang, "settings.h1") }</h2></div>
		@settingsNavHub(lang)
		if data.PWChanged {
			<p class="notice" role="status">{ Tr(lang, "pw.changed") }</p>
		}
		if data.Notice != "" {
			<p class="notice" role="status">{ data.Notice }</p>
		}
		if data.Message != "" {
			<p class="error" role="alert">{ data.Message }</p>
		}
		<details class="settings-fold" open>
			<summary>{ Tr(lang, "settings.authLegend") }</summary>
			<form method="post" action="/admin/settings">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="section" value="auth"/>
				<label><input type="checkbox" name="spfEnabled" { checkedAttrs(data.SPFEnabled)... }/> { Tr(lang, "settings.spf") }</label>
				<label><input type="checkbox" name="dkimEnabled" { checkedAttrs(data.DKIMEnabled)... }/> { Tr(lang, "settings.dkim") }</label>
				<label><input type="checkbox" name="dmarcEnabled" { checkedAttrs(data.DMARCEnabled)... }/> { Tr(lang, "settings.dmarc") }</label>
				<label><input type="checkbox" name="arcEnabled" { checkedAttrs(data.ARCEnabled)... }/> { Tr(lang, "settings.arc") }</label>
				<label>{ Tr(lang, "settings.dkimSel") } <input type="text" name="dkimSelector" value={ data.DKIMSelector } placeholder="s1024" maxlength="64"/></label>
				// A2（β 批）：size 物理宽属性删除——弹性宽经 app.css settings-fold 表单规则承载。
				<label>{ Tr(lang, "settings.dkimKey") } <input type="text" name="dkimKeyPath" value={ data.DKIMKeyPath } placeholder="data/dkim.pem"/></label>
				<label>{ Tr(lang, "settings.dkimAlgo") }
					<input type="text" name="dkimAlgorithm" value={ data.DKIMAlgo } placeholder={ Tr(lang, "settings.dkimAlgoPh") }/>
				</label>
				// 两项变更实施批（SRS v1.2.0 FR-009 档位语义——TC-029 热生效格；G2 批准 2026-10-17 03:37）
				<fieldset>
					<legend>{ Tr(lang, "settings.spfPolicyLegend") }</legend>
					<p class="hint">{ Tr(lang, "settings.spfPolicyHint") }</p>
					<label><input type="radio" name="spfPolicy" value="soft" { checkedAttrs(data.SPFPolicy == "soft")... }/> { Tr(lang, "settings.policySoft") }</label>
					<label><input type="radio" name="spfPolicy" value="hard" { checkedAttrs(data.SPFPolicy == "hard")... }/> { Tr(lang, "settings.policyHard") }</label>
				</fieldset>
				<fieldset>
					<legend>{ Tr(lang, "settings.dkimPolicyLegend") }</legend>
					<p class="hint">{ Tr(lang, "settings.dkimPolicyHint") }</p>
					<label><input type="radio" name="dkimPolicy" value="soft" { checkedAttrs(data.DKIMPolicy == "soft")... }/> { Tr(lang, "settings.policySoft") }</label>
					<label><input type="radio" name="dkimPolicy" value="hard" { checkedAttrs(data.DKIMPolicy == "hard")... }/> { Tr(lang, "settings.policyHard") }</label>
				</fieldset>
				<button class="primary" type="submit">{ Tr(lang, "common.save") }</button>
			</form>
		</details>
		<details class="settings-fold" open>
			<summary>{ Tr(lang, "settings.deliveryLegend") }</summary>
			<form method="post" action="/admin/settings">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="section" value="delivery"/>
				<label><input type="checkbox" name="catchAll" { checkedAttrs(data.CatchAll)... }/> { Tr(lang, "settings.catchAll") }</label>
				<label>{ Tr(lang, "settings.maxSize") } <input type="number" name="maxMessageSizeMB" min="1" value={ strconvItoa64(data.MaxMessageSizeMB) }/></label>
				<label>{ Tr(lang, "settings.retryBase") } <input type="number" name="retryBaseSeconds" min="1" value={ strconvItoa(data.RetryBaseSeconds) }/></label>
				<label>{ Tr(lang, "settings.retryFactor") } <input type="number" name="retryFactor" min="1" value={ strconvItoa(data.RetryFactor) }/></label>
				<label>{ Tr(lang, "settings.retryCap") } <input type="number" name="retryCapSeconds" min="1" value={ strconvItoa(data.RetryCapSeconds) }/></label>
				<label>{ Tr(lang, "settings.maxAttempts") } <input type="number" name="maxAttempts" min="1" value={ strconvItoa(data.MaxAttempts) }/></label>
				<button class="primary" type="submit">{ Tr(lang, "common.save") }</button>
			</form>
		</details>
		<details class="settings-fold" open>
			<summary>{ Tr(lang, "settings.sessionLegend") }</summary>
			<form method="post" action="/admin/settings">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="section" value="session"/>
				<label>{ Tr(lang, "settings.idle") } <input type="number" name="idleMinutes" min="1" value={ strconvItoa(data.IdleMinutes) }/></label>
				<label>{ Tr(lang, "settings.absolute") } <input type="number" name="absoluteHours" min="1" value={ strconvItoa(data.AbsoluteHours) }/></label>
				<label>{ Tr(lang, "settings.limitWin") } <input type="number" name="limitWindowMinutes" min="1" value={ strconvItoa(data.LimitWindowMinutes) }/></label>
				<label>{ Tr(lang, "settings.limitThr") } <input type="number" name="limitThreshold" min="1" value={ strconvItoa64(data.LimitThreshold) }/></label>
				// GRM高危处置批（GRM-004）：提交端点连接上限（G2 附加指示「必须在后台管理设置里可设置」）
				<label>{ Tr(lang, "settings.subMaxConns") } <input type="number" name="submissionMaxConns" min="1" value={ strconvItoa(data.SubmissionMaxConns) }/></label>
				<button class="primary" type="submit">{ Tr(lang, "common.save") }</button>
			</form>
		</details>
		<details class="settings-fold" open>
			<summary>{ Tr(lang, "settings.tlsLegend") }</summary>
			<form method="post" action="/admin/settings">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="section" value="tls"/>
				<label><input type="checkbox" name="mtaStsEnabled" { checkedAttrs(data.MTAStsEnabled)... }/> { Tr(lang, "settings.stsPub") }</label>
				<label>{ Tr(lang, "settings.stsMode") } <input type="text" name="mtaStsMode" value={ data.MTAStsMode } placeholder="enforce | testing"/></label>
				<label>{ Tr(lang, "settings.stsAge") } <input type="number" name="mtaStsMaxAgeSeconds" min="1" max="31557600" value={ strconvItoa(data.MTAStsMaxAgeSeconds) }/></label>
				<label><input type="checkbox" name="tlsrptEnabled" { checkedAttrs(data.TLSRPTEnabled)... }/> { Tr(lang, "settings.tlsrptPub") }</label>
				<label>{ Tr(lang, "settings.rua") } <input type="text" name="tlsrptRuaAddress" value={ data.TLSRPTRuaAddress } placeholder={ Tr(lang, "settings.ruaPh") }/></label>
				<button class="primary" type="submit">{ Tr(lang, "common.save") }</button>
			</form>
		</details>
		<details class="settings-fold" open>
			<summary>{ Tr(lang, "settings.dnsLegend") }</summary>
			// DNS 发布建议只读节（B5：无表单字段零提交承载——E2 折叠仅分组呈现）。
			<p class="hint">{ Tr(lang, "settings.stsHint") }<code>{ data.StsPolicyURL }</code>{ Tr(lang, "settings.stsSanHint") }</p>
			// E9（批二）：记录名渲染真实主域（原「主域」占位词——用户照抄得非法记录名）；
			// 停发态建议值改由键承载（原 Go 侧中文串——E6 同族收口）。
			<p class="hint">TXT <code>_mta-sts.{ data.Domain }</code>{ colonFor(lang) }<code>
				if data.StsTXTRecord == "" {
					{ Tr(lang, "settings.stsOff") }
				} else {
					{ data.StsTXTRecord }
				}
			</code></p>
			<p class="hint">TXT <code>_smtp._tls.{ data.Domain }</code>{ colonFor(lang) }<code>
				if data.TLSRPTRecord == "" {
					{ Tr(lang, "settings.tlsrptOff") }
				} else {
					{ data.TLSRPTRecord }
				}
			</code></p>
		</details>
			</main>
		}
	}

// appLayoutSettings 设置页骨架（AppLayout admin 主体——F01 统一；无 .layout 侧栏：管理
// 全量页沿 content-page 单流形态，对齐 admin/tokens）。
// D3（2026-10-05 B 形态）：nav 为全站侧栏数据（AppFrame 承载；nil=无邮箱异常态降级）。
templ appLayoutSettings(lang Lang, csrf string, nav *MailListData) {
	@AppFrame(lang, Tr(lang, "settings.title"), Tr(lang, "home.adminKind"), true, csrf, nav) {
		{ children... }
	}
}

// strconvItoa int→string（模板表达式包装）。
func strconvItoa(v int) string {
	return fmt.Sprintf("%d", v)
}

// strconvItoa64 int64→string（模板表达式包装）。
func strconvItoa64(v int64) string {
	return fmt.Sprintf("%d", v)
}
