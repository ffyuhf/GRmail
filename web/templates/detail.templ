// GRmail Webmail 详情片段 v2（Webmail设计系统重构批次——阅读效率优先重排）。
// 重排要点（参考网盘前端 EmailDetailView/SideNavItem 设计语义）：操作组前置（回复
// 主按钮+返回次级——使用顺序对齐）；头部卡片化（主题 h2+元信息分组行——发件人/收件/
// 抄送/时间/尺寸，替代旧版「标签：值」纯文本拼串）；正文容器（iframe sandbox 隔离
// 保持——OWASP 渲染红线）；附件卡片化（图标+文件名+hover 浮起）。
// 零变更红线：replyHref 路由/iframe sandbox 语义/CID 改写链（handler 侧 SafeBody）
// 与 U9 末态一致；HTMX 目标 #mail-list 保持。
// 依据：FR-013 核心子集（G24 详情/附件卡片/回复预填——G8）；OWASP（不可信 HTML 正文
// sandbox 隔离）。
// 修改历史：
//   2026-09-19 15:08:00 | 新建 | U9 Webmail 核心（计划书步骤 6）
//   2026-09-24 17:04:00 | 扩展 | U16 Webmail 体验收尾（计划书步骤 4/5，G2 批准 2026-09-24 11:51:57）
//   2026-10-02 18:00:00 | 重构 | Webmail设计系统重构批次阶段B（G2 批准 2026-10-02 17:34:40）
package templates

import (
	"fmt"
	"time"

	"GRmail/internal/mail"
	"GRmail/internal/storage"
)

// iconReply 回复箭头图标（详情主按钮——内联 SVG）。
var iconReply = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17l-6-5 6-5"/><path d="M3 12h11a6 6 0 0 1 6 6v1"/></svg>`

// iconBack 返回箭头图标（次级按钮——内联 SVG）。
var iconBack = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>`

// iconAttach 回形针图标（附件卡片——内联 SVG）。
var iconAttach = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>`

// DetailView 详情片段（HTMX 目标 #mail-list 整体替换；返回按钮回列表首屏）。
// 参数：lang 界面语言；msg 详情行；disp 展示模型（附件清单）；safeBody 渲染主体
//（HTML 已 CID 改写/纯文本原文——组件自动转义或 srcdoc 承载）；bodyIsHTML 形态标记；
// csrf 会话 token。
templ DetailView(lang Lang, msg *storage.Detail, disp *mail.Display, safeBody string, bodyIsHTML bool, csrf string) {
	<div class="detail">
		<div class="actions">
			<a class="primary" href={ replyHref(msg.ID) }>
				<span class="ic" aria-hidden="true">@templ.Raw(iconReply)</span>
				{ Tr(lang, "detail.reply") }
			</a>
			<button class="secondary" hx-get={ fmt.Sprintf("/mails?folder=%d&page=1", msg.FolderID) } hx-target="#mail-list">
				<span class="ic" aria-hidden="true">@templ.Raw(iconBack)</span>
				{ Tr(lang, "common.back") }
			</button>
		</div>
		<div class="detail-head">
			<h2>{ subj(lang, msg.Subject) }</h2>
			<div class="meta-row">
				<span>{ detailFromLine(lang, msg.FromAddr) }</span>
				<span>{ detailToLine(lang, msg.ToAddrs) }</span>
				<span>{ detailCcLine(lang, msg.CcAddrs) }</span>
			</div>
			<div class="meta-row">
				<span>{ detailTimeLine(lang, fmtDateTime(msg.SentAt)) }</span>
				<span>{ detailSizeLine(lang, msg.RawSize) }</span>
			</div>
		</div>
		<hr/>
		if bodyIsHTML {
			<iframe sandbox="" srcdoc={ safeBody } title={ Tr(lang, "detail.bodyFrame") }></iframe>
		} else {
			<pre>{ safeBody }</pre>
		}
		if len(disp.Attachments) > 0 {
			<h3>{ Tr(lang, "detail.attach") }</h3>
			<div class="attach-list">
				for _, a := range disp.Attachments {
					<div class="attach">
						<a href={ fmt.Sprintf("/attachments/%d?part=%d", msg.ID, a.Part) }>
							<span class="ic" aria-hidden="true">@templ.Raw(iconAttach)</span>
							{ attachLabel(lang, a.Filename, a.ContentType, a.Size) }
						</a>
					</div>
				}
			</div>
		}
	</div>
}

// replyHref 回复入口（G8 回信参数预填）。
func replyHref(id int64) string {
	return fmt.Sprintf("/compose?reply=%d", id)
}

// subj 空主题兜底（双语——U16）。
func subj(lang Lang, s string) string {
	if s == "" {
		return Tr(lang, "mail.noSubject")
	}
	return s
}

// detailFromLine/toLine/ccLine 元数据行片段（「标签：值」单表达式拼串——规避 templ
// 多表达式邻接解析边界；F12：分隔由 meta-row flex gap 承载（全角空格移除——Webmail界面精修批次）。
func detailFromLine(lang Lang, from string) string {
	return Tr(lang, "detail.from") + "：" + from
}

func detailToLine(lang Lang, toAddrs string) string {
	return Tr(lang, "detail.to") + "：" + prettyList(toAddrs)
}

func detailCcLine(lang Lang, ccAddrs string) string {
	return Tr(lang, "detail.cc") + "：" + prettyList(ccAddrs)
}

func detailTimeLine(lang Lang, t string) string {
	return Tr(lang, "detail.time") + "：" + t
}

// F10：字节数人类可读格式（B/KB/MB/GB 自适应一位小数——Webmail界面精修批次）。
func fmtSize(size int64) string {
	switch {
	case size >= 1<<30:
		return fmt.Sprintf("%.1f GB", float64(size)/(1<<30))
	case size >= 1<<20:
		return fmt.Sprintf("%.1f MB", float64(size)/(1<<20))
	case size >= 1<<10:
		return fmt.Sprintf("%.1f KB", float64(size)/(1<<10))
	default:
		return fmt.Sprintf("%d B", size)
	}
}

func detailSizeLine(lang Lang, size int64) string {
	return Tr(lang, "detail.size") + "：" + fmtSize(size)
}

// prettyList JSON 数组缓存串 → 逗号呈现。
func prettyList(jsonArr string) string {
	if jsonArr == "" {
		return "—"
	}
	out := ""
	inner := jsonArr[1 : len(jsonArr)-1]
	for i, part := range splitTrim(inner) {
		if i > 0 {
			out += ", "
		}
		out += trimQuotes(part)
	}
	return out
}

// splitTrim 逗号切分去空白。
func splitTrim(s string) []string {
	var out []string
	start := 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ',' {
			seg := trimSpace(s[start:i])
			if seg != "" {
				out = append(out, seg)
			}
			start = i + 1
		}
	}
	return out
}

// trimQuotes 去双引号。
func trimQuotes(s string) string {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return s[1 : len(s)-1]
	}
	return s
}

// trimSpace 简易去两端空白（模板包免引 strings）。
func trimSpace(s string) string {
	for len(s) > 0 && (s[0] == ' ' || s[0] == '\t') {
		s = s[1:]
	}
	for len(s) > 0 && (s[len(s)-1] == ' ' || s[len(s)-1] == '\t') {
		s = s[:len(s)-1]
	}
	return s
}

// fmtDateTime 时间呈现（F04：真实格式化——原空占位恒返「—」为 U9 遗留缺陷；
// 零值「—」；沿 tokens.templ formatTokenTime 先例——Webmail界面精修批次 2026-10-03）。
func fmtDateTime(t time.Time) string {
	if t.IsZero() {
		return "—"
	}
	return t.Local().Format("2006-01-02 15:04")
}

// attachLabel 附件卡片文案（双语——U16；F10：尺寸人类可读格式）。
func attachLabel(lang Lang, filename, contentType string, size int64) string {
	if filename == "" {
		filename = Tr(lang, "detail.unnamed")
	}
	return fmt.Sprintf("%s（%s，%s）", filename, contentType, fmtSize(size))
}
