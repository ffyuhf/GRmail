// GRmail Webmail 应用骨架 v2（Webmail设计系统重构批次——信息架构重排）。
// 结构（参考网盘前端 NavBarFrame/TopAppBar/AppDrawer 设计语义，templ+HTMX 等效实现）：
//   应用栏 .app-bar——左区（汉堡+品牌+主体标签）/右区 .app-bar-actions（写信主按钮+
//   管理菜单 menu-host[admin 主体] 或 2FA 入口[mailbox 主体]+账户菜单：语言/登出）；
//   抽屉状态 #nav-toggle（checked 默认=桌面 persistent 展开；移动 Slide 浮层+遮罩）；
//   交互脚本 /static/grmail.js（菜单外点关闭/选中计数/抽屉联动——零依赖自研）。
// 零变更红线（计划书 1.3）：全部链接 href/表单 action/CSRF 埋域/语言切换端点与
// U9 末态一致；业务语义/HTMX 端点零触碰。
// 修改历史：
//   2026-09-19 15:04:00 | 新建 | U9 Webmail 核心（计划书步骤 5）
//   2026-09-24 16:52:00 | 扩展 | U16 Webmail 体验收尾（计划书步骤 4/5，G2 批准 2026-09-24 11:51:57）
//   2026-10-02 13:40:00 | 扩展 | Webmail视觉重构批次阶段3（G2 批准 2026-10-02 13:20:06）
//   2026-10-02 17:50:00 | 重构 | Webmail设计系统重构批次阶段A（G2 批准 2026-10-02 17:34:40）
//   2026-10-05 00:22:00 | 修正 | Setup向导缺陷修复批次（缺陷④b）：langSwitchHref 签名
//   增 next 参数（空串容错省略——端点 next="/" 兜底既有）；顶栏调用点传 "/"（主界面
//   切语言回首页——既有行为等价）；调用点编译期强校验零遗漏
//   （依据：Setup向导缺陷修复计划书 v1.0.0 1.2 组4b，G2 批准 2026-10-05 00:21:19）
//   2026-10-15 00:40:00 | 修正 | Webmail前端可见性一致性令牌批 β：A1 theme-color
//   双 media 拆分（暗色适配——亮色 #1976d2 零变化锚）+C1 枢纽图标库三增
//   （iconLock/iconList/iconMail——settings_hub 消费）
//   （依据：β批计划书 v1.0.0 1.2 A1/C1，G2 批准 2026-10-15 00:12）
package templates

// iconMenu 汉堡菜单图标（F05：☰ 字符改 SVG——基准 TopAppBar Material Menu 同构；
// Webmail界面精修批次 2026-10-03）。
var iconMenu = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>`

// iconMore 竖三点图标（账户/管理菜单触发器——内联 SVG currentColor）。
var iconMore = `<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg>`

// iconCaret 下箭头（菜单指示——open 态 CSS 旋转 180°）。
var iconCaret = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>`

// iconEdit 写信图标（主按钮——内联 SVG currentColor）。
var iconEdit = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>`

// iconLang 语言图标（菜单项）。
var iconLang = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`

// iconLogout 登出图标（菜单项）。
var iconLogout = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>`

// iconShield 2FA 盾牌图标（菜单项）。
var iconShield = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`

// iconLock 锁图标（C1 β 批：枢纽「修改密码」卡片——emoji→SVG 收口）。
var iconLock = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`

// iconList 清单图标（C1 β 批：枢纽「过滤规则」卡片）。
var iconList = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>`

// iconMail 信封图标（C1 β 批：枢纽「返回邮箱」卡片）。
var iconMail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>`

// AppLayout Webmail 页面骨架（登录后各页统一应用栏+抽屉容器）。
// 参数：lang 界面语言；title 页面标题；label 主体呈现名；isAdmin admin 主体标记；csrf 会话绑定 token。
templ AppLayout(lang Lang, title string, label string, isAdmin bool, csrf string) {
	<!DOCTYPE html>
	<html lang={ langAttrFor(lang) } data-confirm-default={ Tr(lang, "common.confirm") }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - GRmail</title>
			// H1（批二）：htmx defer——首屏解析并行（原阻塞；grmail.js defer 既有对齐）。
			<script src={ StaticURL("/static/htmx.min.js") } defer></script>
			<script src={ StaticURL("/static/grmail.js") } defer></script>
			<link rel="stylesheet" href={ StaticURL("/static/app.css") }/>
			// H3（批二）：favicon+manifest+theme-color（原每页 favicon.ico 404）。
			<link rel="icon" href={ StaticURL("/static/favicon.svg") } type="image/svg+xml"/>
			<link rel="manifest" href={ StaticURL("/static/manifest.webmanifest") }/>
			// A1（β 批）：theme-color 双 media 拆分——暗色系统窗口色条随 --bg 暗档
			// #212121 适配（亮色 #1976d2 零变化锚）。
			<meta name="theme-color" content="#1976d2" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#212121" media="(prefers-color-scheme: dark)"/>
		</head>
		<body>
			// G1（批二）：跳转链接（键盘用户跳过侧栏直达主内容）+H6 noscript 降级说明。
			<a class="skip-link" href="#main-content">{ Tr(lang, "common.skipMain") }</a>
			<noscript><p class="notice">{ Tr(lang, "common.nojs") }</p></noscript>
			<input type="checkbox" id="nav-toggle" class="nav-toggle-input" checked hidden/>
			<header class="app-bar">
				// G2（批二）：抽屉开关键盘可达（label tabindex=0+role=button+Enter/Space
				// 触发归 grmail.js；aria-label Tr 化——E5 硬编码 "menu" 收口）。
				<label class="nav-toggle" for="nav-toggle" role="button" tabindex="0" aria-label={ Tr(lang, "top.menu") }><span class="ic" aria-hidden="true">@templ.Raw(iconMenu)</span></label>
				<a class="app-bar-brand" href="/">GRmail<span class="app-bar-label">{ label }</span></a>
				<div class="app-bar-actions">
					<a class="primary" href="/compose">
						<span class="ic" aria-hidden="true">@templ.Raw(iconEdit)</span>
						{ Tr(lang, "top.compose") }
					</a>
					if isAdmin {
						// G12（批二）：summary 增 aria-haspopup（开合态 aria-expanded 由
						// grmail.js details toggle 事件维护——纯静态无法反射）。
						<details class="menu-host">
							<summary aria-haspopup="menu">
								<span class="ic" aria-hidden="true">@templ.Raw(iconShield)</span>
								{ Tr(lang, "top.manage") }
								<span class="ic ic-caret" aria-hidden="true">@templ.Raw(iconCaret)</span>
							</summary>
							<div class="menu" role="menu">
								<a href="/admin/mailboxes" role="menuitem">{ Tr(lang, "top.adminMail") }</a>
								<a href="/admin/settings" role="menuitem">{ Tr(lang, "top.settings") }</a>
								<a href="/admin/2fa" role="menuitem">{ Tr(lang, "hub.twofactor") }</a>
							</div>
						</details>
					}
					<details class="menu-host">
						<summary aria-label={ Tr(lang, "top.account") } aria-haspopup="menu">
							<span class="ic" aria-hidden="true">@templ.Raw(iconMore)</span>
						</summary>
						<div class="menu" role="menu">
							if isAdmin {
								<a href="/admin/password" role="menuitem">{ Tr(lang, "top.password") }</a>
							} else {
								<a href="/settings" role="menuitem">{ Tr(lang, "top.settingsHub") }</a>
								// F6（批二）：mailbox 主体 2FA 直达入口（原仅 hub 页分区
								// 可达——顶栏直达补齐；iconShield 复用）。
								<a href="/settings/2fa" role="menuitem">{ Tr(lang, "top.twofactor") }</a>
							}
							<a href={ langSwitchHref(lang, "") } role="menuitem">
								<span class="ic" aria-hidden="true">@templ.Raw(iconLang)</span>
								{ Tr(lang, "top.lang") }
							</a>
							<hr/>
							<form method="post" action="/logout">
								<input type="hidden" name="csrf_token" value={ csrf }/>
								<button type="submit" class="menu-danger">
									<span class="ic" aria-hidden="true">@templ.Raw(iconLogout)</span>
									{ Tr(lang, "common.logout") }
								</button>
							</form>
						</div>
					</details>
				</div>
			</header>
			{ children... }
		</body>
	</html>
}

// AppFrame 带侧栏的应用骨架（D3——侧栏交互缺陷修复批次 B 形态定稿：S3-W Q1=B
// 2026-10-05 18:28:52）。设置族页统一渲染 Sidebar（全站侧栏导航——汉堡按钮全站
// 行为一致，移动端设置页可经侧栏返回邮箱）；children 自带 .main 容器（compose 页
// id/data 属性等页面级定制保持）。nav 为 nil 时退化为无侧栏形态（无邮箱异常态防御
// ——AppLayout 原直出语义）。
// 参数：前五参同 AppLayout；nav 侧栏数据（MailListData 的 Folders/CSRF/Lang/Pagesize
// 字段子集——Items/Total 等列表域字段零值不消费）。
templ AppFrame(lang Lang, title string, label string, isAdmin bool, csrf string, nav *MailListData) {
	@AppLayout(lang, title, label, isAdmin, csrf) {
		// G1（批二）：页面主地标 h1（sr-only——视觉保持顶栏品牌，语义地标齐备）。
		<h1 class="sr-only">{ title }</h1>
		if nav != nil {
			<div class="layout">
				@Sidebar(nav)
				{ children... }
				// C4（批二）：遮罩改真实 label（for=nav-toggle 点击可关——原 ::after
				// 伪元素不可交互，移动端展开后唯一关闭路径残缺；样式接 .drawer-scrim）。
				<label class="drawer-scrim" for="nav-toggle" aria-hidden="true"></label>
			</div>
		} else {
			{ children... }
		}
	}
}

// langSwitchHref 语言切换链接（GET /lang——l 取目标语言（当前取反）、next 回当前路径）。
// 参数：lang 当前语言；next 切换后回跳的站内路径（空=省略参数，由端点 next="/" 兜底——
// 缺陷④b 修复前该参数缺失致切换后恒跳首步/首页）。返回：切换端点 href。
func langSwitchHref(lang Lang, next string) string {
	target := "en"
	if lang == LangEN {
		target = "zh"
	}
	if next == "" {
		return "/lang?l=" + target
	}
	return "/lang?l=" + target + "&next=" + next
}
