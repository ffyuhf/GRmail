// GRmail Webmail 写信页 v2（Webmail设计系统重构批次——分区布局重排）。
// 重排要点（参考网盘前端 EditerView/RadiusFrame 设计语义）：表单分区化——收件人区
// （to/cc/bcc 标签字段+CSV 导入折叠收纳）→主题区→正文区（编辑器容器+全屏切换）→
// 附件区→动作栏（发送 primary/存草稿 secondary/取消 text 主次分离）；高频发送按钮
// 恒可见（表单底部+主色）。
// 零变更红线（计划书 1.3）：表单 action/enctype/onsubmit/全部 name 字段（to/cc/bcc/
// from/subject/body/attachments/action/draft_id/csrf_token）/data-* 断言锚（data-img-
// max-edge/data-jpeg-quality）/Quill vendor 与 U17/U22 内联 JS（编辑器初始化/图片压缩/
// CSV 导入/全屏）1:1 保留；#compose-toolbar/#editor-container/#editor-initial/
// #f-body/#f-to/#f-cc/#f-bcc/#csv-* ID 锚全保持（JS 依赖）。
// 依据：FR-013（G3 富文本/G4 全屏/G5 CSV/G8 预填/G9 图片内联）；U17 Q2/Q3、U22 S3-W
// 候选 B 裁决（八组控件+Canvas 压缩）；D8#11/D8#14（config 压缩参数/gif 跳过）。
// 编辑器收尾增量：E-A（D8#10）macOS ⌘ 记法自适应（grmailAdaptShortcutTitles——
// 服务端 title 初值保持 Ctrl 记法锚）；E-B（D8#13）表格按钮（ql-table——Quill 2.0.3
// 内置 table 模块 insertTable(2,2) 工具栏化）。
// 修改历史：
//   2026-09-19 15:16:00 | 新建 | U9 Webmail 核心（计划书步骤 8）
//   2026-09-24 17:00:00 | 扩展 | U16 Webmail 体验收尾（计划书步骤 4/6，G2 批准 2026-09-24 11:51:57）
//   2026-09-24 23:08:00 | 扩展 | U17 富文本编辑器（计划书步骤 4，G2 批准 2026-09-24 22:51:39）
//   2026-09-27 10:58:00 | 扩展 | U22 富文本高级特性（计划书步骤 2，G2 批准 2026-09-27 10:38:20）
//   2026-10-02 18:05:00 | 重构 | Webmail设计系统重构批次阶段C（G2 批准 2026-10-02 17:34:40）
//   2026-10-03 07:40:00 | 扩展 | 编辑器收尾与e2e批次（计划书步骤 3/4，G2 批准 2026-10-03 07:34:18）
//   2026-10-14 20:45:00 | 修正 | Webmail前端可用性收口批 B3/B4：main 增 data-attach-err/
//   data-rcpt-err 双语注入（前端预检与失焦提示文案通道——G2 批准 2026-10-14 20:37）
package templates

import "fmt"

// ComposeView 写信页（AppLayout+分区表单；action=send/save_draft；draft_id 编辑覆盖态；
// CSV 导入折叠区：上传→/compose/csv-import 解析→候选勾选→内联 JS 合入目标字段；
// 富文本区：toolbar 容器+编辑器容器+初始内容隐藏 textarea（HTML 源文本经 .value 读出）。
// 参数：d 表单数据（Lang 驱动双语渲染；Body 承载 HTML 态——编辑器初始内容/回显；
// ErrText 非空时呈现错误条）。
templ ComposeView(d *ComposeData) {
	{{ lang := NormalizeLang(d.Lang) }}
	@AppFrame(lang, Tr(lang, "compose.title"), Tr(lang, "compose.title"), d.IsAdmin, d.CSRF, d.Nav) {
		// B10（批五）：main 地标补齐（#compose-page id 保持——JS 依赖锚；skip-link
		// 跳转目标 #main-content 经 main 标签+既有 id 双锚承载）。
		// B3/B4（α 批）：data-attach-err（附件前端预检文案——err.attachTooLarge 既有键）/
		// data-rcpt-err（收件人失焦提示文案——compose.rcptHint 本批新键）双语注入
		//（compose.js dataset 消费——沿 data-csv-err 先例）。
		<main class="main" id="compose-page" data-img-max-edge={ fmt.Sprintf("%d", d.ImgMaxEdgeAttr()) } data-jpeg-quality={ fmt.Sprintf("%g", d.JpegQualityAttr()) } data-csv-err={ Tr(lang, "compose.csvErr") } data-attach-err={ Tr(lang, "err.attachTooLarge") } data-rcpt-err={ Tr(lang, "compose.rcptHint") } data-files-fmt={ Tr(lang, "compose.filesFmt") }>
			<form method="post" action="/compose" enctype="multipart/form-data" id="compose-form">
				<input type="hidden" name="csrf_token" value={ d.CSRF }/>
				if d.DraftID > 0 {
					<input type="hidden" name="draft_id" value={ fmt.Sprintf("%d", d.DraftID) }/>
				}
				if d.ErrText != "" {
					<p class="error" role="alert">{ d.ErrText }</p>
				}
				<section class="compose-section">
					<div class="section-label">{ Tr(lang, "compose.rcpt") }</div>
					<div class="compose-rcpt-grid">
						// D2（批二）：地址输入 email 语义（inputmode/autocapitalize/spellcheck）。
						// A-8（前端报告批）：首字段可视标签 sr-only 化——分区标题 compose.rcpt
						// 「收件人」已承载语义（第三方报告 P1-5 标签重复收口；占位符保持输入
						// 提示；读屏控件名经 sr-only 保持——沿批五 C2 先例）。
						<label><span class="sr-only">{ Tr(lang, "compose.to") }</span><input type="text" name="to" id="f-to" value={ d.To } placeholder="user@example.com" inputmode="email" autocapitalize="none" spellcheck="false"/></label>
						<label><span>{ Tr(lang, "compose.cc") }</span><input type="text" name="cc" id="f-cc" value={ d.Cc } inputmode="email" autocapitalize="none" spellcheck="false"/></label>
						<label><span>{ Tr(lang, "compose.bcc") }</span><input type="text" name="bcc" id="f-bcc" value={ d.Bcc } inputmode="email" autocapitalize="none" spellcheck="false"/></label>
					</div>
					<details>
						<summary>{ Tr(lang, "compose.csvImport") }</summary>
						<div class="actions">
							// D1（批二）：CSV file/select 程序化名称；G3：结果区 aria-live 播报。
							<input type="file" id="csv-file" accept=".csv,text/csv" aria-label={ Tr(lang, "compose.csvImport") }/>
							<select id="csv-target" aria-label={ Tr(lang, "compose.csvImport") }>
								<option value="f-to">{ Tr(lang, "compose.to") }</option>
								<option value="f-cc">{ Tr(lang, "compose.cc") }</option>
								<option value="f-bcc">{ Tr(lang, "compose.bcc") }</option>
							</select>
							<button class="secondary" type="button" id="csv-parse-btn">{ Tr(lang, "compose.csvParse") }</button>
						</div>
						<div id="csv-result" aria-live="polite"></div>
					</details>
					if d.IsAdmin {
						<label><span>{ Tr(lang, "compose.from") }</span><input type="text" name="from" id="f-from" value={ d.From } placeholder={ Tr(lang, "compose.fromPh") } data-domain={ d.Domain } autocomplete="off" inputmode="email" autocapitalize="none" spellcheck="false"/></label>
					}
				</section>
				<section class="compose-section">
					<div class="section-label">{ Tr(lang, "compose.subject") }</div>
					// C2（批五）：空 label 补 sr-only 文本（原 label 内仅 input——读屏「未命名
					// 编辑框」；既有键复用零新增）。
					<label><span class="sr-only">{ Tr(lang, "compose.subject") }</span><input type="text" name="subject" value={ d.Subject } placeholder={ Tr(lang, "compose.subjectPh") }/></label>
				</section>
				<section class="compose-section">
					<div class="section-label">
						<span>{ Tr(lang, "compose.body") }</span>
						<span class="tool-spacer"></span>
						<button class="secondary btn-sm" type="button" id="fullscreen-btn"
								data-enter={ Tr(lang, "compose.fullscreen") }
								data-exit={ Tr(lang, "compose.exitFullscreen") }>{ Tr(lang, "compose.fullscreen") }</button>
					</div>
					<input type="hidden" name="body" id="f-body" value=""/>
					// C2（批五）：工具栏 20 控件补 aria-label（title 保留桌面 tooltip；aria-label
					// 读屏直达——title 对读屏支持有限；既有键族复用零新增）。
					<div id="compose-toolbar">
							<button type="button" class="ql-bold" title={ Tr(lang, "compose.tb.bold") } aria-label={ Tr(lang, "compose.tb.bold") }></button>
							<button type="button" class="ql-italic" title={ Tr(lang, "compose.tb.italic") } aria-label={ Tr(lang, "compose.tb.italic") }></button>
							<button type="button" class="ql-underline" title={ Tr(lang, "compose.tb.underline") } aria-label={ Tr(lang, "compose.tb.underline") }></button>
							<button type="button" class="ql-strike" title={ Tr(lang, "compose.tb.strike") } aria-label={ Tr(lang, "compose.tb.strike") }></button>
							<select class="ql-color" title={ Tr(lang, "compose.tb.color") } aria-label={ Tr(lang, "compose.tb.color") }>
								<option value=""></option>
								<option value="#000000"></option>
								<option value="#374151"></option>
								<option value="#9ca3af"></option>
								<option value="#ffffff"></option>
								<option value="#dc2626"></option>
								<option value="#ea580c"></option>
								<option value="#d97706"></option>
								<option value="#16a34a"></option>
								<option value="#0d9488"></option>
								<option value="#2563eb"></option>
								<option value="#7c3aed"></option>
								<option value="#db2777"></option>
							</select>
							<select class="ql-background" title={ Tr(lang, "compose.tb.background") } aria-label={ Tr(lang, "compose.tb.background") }>
								<option value=""></option>
								<option value="#000000"></option>
								<option value="#374151"></option>
								<option value="#9ca3af"></option>
								<option value="#ffffff"></option>
								<option value="#dc2626"></option>
								<option value="#ea580c"></option>
								<option value="#d97706"></option>
								<option value="#16a34a"></option>
								<option value="#0d9488"></option>
								<option value="#2563eb"></option>
								<option value="#7c3aed"></option>
								<option value="#db2777"></option>
							</select>
							<select class="ql-size" title={ Tr(lang, "compose.tb.size") } aria-label={ Tr(lang, "compose.tb.size") }>
								<option value="small">{ Tr(lang, "compose.tb.sizeSmall") }</option>
								<option value="" selected="selected">{ Tr(lang, "compose.tb.sizeNormal") }</option>
								<option value="large">{ Tr(lang, "compose.tb.sizeLarge") }</option>
								<option value="huge">{ Tr(lang, "compose.tb.sizeHuge") }</option>
							</select>
							<select class="ql-font" title={ Tr(lang, "compose.tb.font") } aria-label={ Tr(lang, "compose.tb.font") }>
								<option value="" selected="selected">{ Tr(lang, "compose.tb.fontDefault") }</option>
								<option value="serif">{ Tr(lang, "compose.tb.fontSerif") }</option>
								<option value="monospace">{ Tr(lang, "compose.tb.fontMono") }</option>
							</select>
							<select class="ql-header" title={ Tr(lang, "compose.tb.h1") } aria-label={ Tr(lang, "compose.tb.h1") }>
								<option value="1">{ Tr(lang, "compose.tb.h1") }</option>
								<option value="2">{ Tr(lang, "compose.tb.h2") }</option>
								<option value="" selected="selected">{ Tr(lang, "compose.tb.headerNormal") }</option>
							</select>
							<button type="button" class="ql-blockquote" title={ Tr(lang, "compose.tb.blockquote") } aria-label={ Tr(lang, "compose.tb.blockquote") }></button>
							<button type="button" class="ql-code-block" title={ Tr(lang, "compose.tb.codeBlock") } aria-label={ Tr(lang, "compose.tb.codeBlock") }></button>
							<button type="button" class="ql-table" title={ Tr(lang, "compose.tb.table") } aria-label={ Tr(lang, "compose.tb.table") }></button>
							<button type="button" class="ql-list" value="ordered" title={ Tr(lang, "compose.tb.listOrdered") } aria-label={ Tr(lang, "compose.tb.listOrdered") }></button>
							<button type="button" class="ql-list" value="bullet" title={ Tr(lang, "compose.tb.listBullet") } aria-label={ Tr(lang, "compose.tb.listBullet") }></button>
							<button type="button" class="ql-align" value="" title={ Tr(lang, "compose.tb.alignLeft") } aria-label={ Tr(lang, "compose.tb.alignLeft") }></button>
							<button type="button" class="ql-align" value="center" title={ Tr(lang, "compose.tb.alignCenter") } aria-label={ Tr(lang, "compose.tb.alignCenter") }></button>
							<button type="button" class="ql-align" value="right" title={ Tr(lang, "compose.tb.alignRight") } aria-label={ Tr(lang, "compose.tb.alignRight") }></button>
							<button type="button" class="ql-align" value="justify" title={ Tr(lang, "compose.tb.alignJustify") } aria-label={ Tr(lang, "compose.tb.alignJustify") }></button>
							<button type="button" class="ql-indent" value="-1" title={ Tr(lang, "compose.tb.indentLess") } aria-label={ Tr(lang, "compose.tb.indentLess") }></button>
							<button type="button" class="ql-indent" value="+1" title={ Tr(lang, "compose.tb.indentMore") } aria-label={ Tr(lang, "compose.tb.indentMore") }></button>
							<button type="button" class="ql-undo" title={ Tr(lang, "compose.tb.undo") } aria-label={ Tr(lang, "compose.tb.undo") }></button>
							<button type="button" class="ql-redo" title={ Tr(lang, "compose.tb.redo") } aria-label={ Tr(lang, "compose.tb.redo") }></button>
							<button type="button" class="ql-link" title={ Tr(lang, "compose.tb.link") } aria-label={ Tr(lang, "compose.tb.link") }></button>
							<button type="button" class="ql-image" title={ Tr(lang, "compose.tb.image") } aria-label={ Tr(lang, "compose.tb.image") }></button>
							<button type="button" class="ql-clean" title={ Tr(lang, "compose.tb.clean") } aria-label={ Tr(lang, "compose.tb.clean") }></button>
						</div>
					<div class="compose-editor" id="editor-container"></div>
					<textarea id="editor-initial" hidden>{ d.Body }</textarea>
				</section>
				<section class="compose-section">
					<div class="section-label">{ Tr(lang, "compose.attach") }</div>
					// A-8（前端报告批）：附件原生英文控件收口——input 视觉隐藏+label 承载
					// 双语「选择文件」文案+已选文件名回显（#attach-names——compose.js change
					// 联动；第三方报告 P1-5）；input 保持可聚焦（键盘路径），label 包裹点击
					// 触发原生选择器；读屏控件名经 aria-label 保持（批五 C2 语义延续）。
					<label class="file-pick">
						<input type="file" name="attachments" multiple="multiple" aria-label={ Tr(lang, "compose.attach") }/>
						<span class="btn-text">{ Tr(lang, "compose.attachBrowse") }</span>
						<span id="attach-names" class="hint" role="status"></span>
					</label>
				</section>
				<div class="compose-actions">
					// D2/E-3-A（批五——干系人指示 2026-10-13 08:42:57 逐字「D2 回车误发缓解
					// Ctrl+回车发送 直接回车是换行处理。」+G2 五组候选全 A）：save_draft DOM 序
					// 前置（回车隐式提交兜底命中草稿——误发变误存）；发送按钮视觉主位经 CSS
					// order 恢复（app.css D2 块——send 恒显示在先，视觉主次零变化锚）。
					<button class="secondary" type="submit" name="action" value="save_draft">{ Tr(lang, "compose.saveDraft") }</button>
					<button class="primary" type="submit" name="action" value="send">{ Tr(lang, "compose.send") }</button>
					<span class="spacer"></span>
					<a class="btn-text" href="/">{ Tr(lang, "common.cancel") }</a>
				</div>
			</form>
		// H2（批二）：编辑器资源前置（原 body 尾容器内——FOUC/CLS 收口；defer 保序）。
		<link rel="stylesheet" href={ StaticURL("/static/quill.snow.css") }/>
		<script src={ StaticURL("/static/quill.js") } defer></script>
		<script src={ StaticURL("/static/compose.js") } defer></script>
		</main>
	}
}
