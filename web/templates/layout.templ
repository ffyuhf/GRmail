// GRmail Web 页面骨架（templ 组件，CON-002：Gin + templ + HTMX 范式）。
// U8 范围：登录双端点与占位首页骨架；U9：Webmail 业务页面。
// U16 增量（Q1-A/Q2-A）：内联样式迁移 web/static/app.css（令牌化+暗色+移动端——
// G1/G2/G26）+lang 参数贯通（html lang 联动——G29 双语判定序 cookie→缺省 zh）。
// Webmail设计系统重构批次：无结构变化（错误提示位样式经 app.css v2 .error 承载）。
// 修改历史：
//   2026-09-19 05:10:00 | 新建 | U8 Web 会话与登录（计划书步骤 7）
//   2026-09-24 16:50:00 | 扩展 | U16 Webmail 体验收尾（计划书步骤 4/5，G2 批准 2026-09-24 11:51:57）
//   2026-10-02 18:10:00 | 注记 | Webmail设计系统重构批次阶段D（G2 批准 2026-10-02 17:34:40）
package templates

// Layout 页面骨架：统一 <head> 与错误提示位（登录失败统一模糊文本——防枚举口径）。
// 参数：lang 界面语言（html lang 联动）；title 页面标题；errText 错误提示（空串不渲染）。
templ Layout(lang Lang, title string, errText string) {
	<!DOCTYPE html>
	<html lang={ string(lang) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			if errText != "" {
				<p class="error" role="alert">{ errText }</p>
			}
			{ children... }
		</body>
	</html>
}
