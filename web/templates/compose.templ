// GRmail Webmail 写信页 v2（Webmail设计系统重构批次——分区布局重排）。
// 重排要点（参考网盘前端 EditerView/RadiusFrame 设计语义）：表单分区化——收件人区
// （to/cc/bcc 标签字段+CSV 导入折叠收纳）→主题区→正文区（编辑器容器+全屏切换）→
// 附件区→动作栏（发送 primary/存草稿 secondary/取消 text 主次分离）；高频发送按钮
// 恒可见（表单底部+主色）。
// 零变更红线（计划书 1.3）：表单 action/enctype/onsubmit/全部 name 字段（to/cc/bcc/
// from/subject/body/attachments/action/draft_id/csrf_token）/data-* 断言锚（data-img-
// max-edge/data-jpeg-quality）/Quill vendor 与 U17/U22 内联 JS（编辑器初始化/图片压缩/
// CSV 导入/全屏）1:1 保留；#compose-toolbar/#editor-container/#editor-initial/
// #f-body/#f-to/#f-cc/#f-bcc/#csv-* ID 锚全保持（JS 依赖）。
// 依据：FR-013（G3 富文本/G4 全屏/G5 CSV/G8 预填/G9 图片内联）；U17 Q2/Q3、U22 S3-W
// 候选 B 裁决（八组控件+Canvas 压缩）；D8#11/D8#14（config 压缩参数/gif 跳过）。
// 编辑器收尾增量：E-A（D8#10）macOS ⌘ 记法自适应（grmailAdaptShortcutTitles——
// 服务端 title 初值保持 Ctrl 记法锚）；E-B（D8#13）表格按钮（ql-table——Quill 2.0.3
// 内置 table 模块 insertTable(2,2) 工具栏化）。
// 修改历史：
//   2026-09-19 15:16:00 | 新建 | U9 Webmail 核心（计划书步骤 8）
//   2026-09-24 17:00:00 | 扩展 | U16 Webmail 体验收尾（计划书步骤 4/6，G2 批准 2026-09-24 11:51:57）
//   2026-09-24 23:08:00 | 扩展 | U17 富文本编辑器（计划书步骤 4，G2 批准 2026-09-24 22:51:39）
//   2026-09-27 10:58:00 | 扩展 | U22 富文本高级特性（计划书步骤 2，G2 批准 2026-09-27 10:38:20）
//   2026-10-02 18:05:00 | 重构 | Webmail设计系统重构批次阶段C（G2 批准 2026-10-02 17:34:40）
//   2026-10-03 07:40:00 | 扩展 | 编辑器收尾与e2e批次（计划书步骤 3/4，G2 批准 2026-10-03 07:34:18）
package templates

import "fmt"

// ComposeView 写信页（AppLayout+分区表单；action=send/save_draft；draft_id 编辑覆盖态；
// CSV 导入折叠区：上传→/compose/csv-import 解析→候选勾选→内联 JS 合入目标字段；
// 富文本区：toolbar 容器+编辑器容器+初始内容隐藏 textarea（HTML 源文本经 .value 读出）。
// 参数：d 表单数据（Lang 驱动双语渲染；Body 承载 HTML 态——编辑器初始内容/回显；
// ErrText 非空时呈现错误条）。
templ ComposeView(d *ComposeData) {
	{{ lang := NormalizeLang(d.Lang) }}
	@AppFrame(lang, Tr(lang, "compose.title"), Tr(lang, "compose.title"), d.IsAdmin, d.CSRF, d.Nav) {
		<div class="main" id="compose-page" data-img-max-edge={ fmt.Sprintf("%d", d.ImgMaxEdgeAttr()) } data-jpeg-quality={ fmt.Sprintf("%g", d.JpegQualityAttr()) } data-csv-err={ Tr(lang, "compose.csvErr") }>
			<form method="post" action="/compose" enctype="multipart/form-data" onsubmit="return grmailComposeSync();">
				<input type="hidden" name="csrf_token" value={ d.CSRF }/>
				if d.DraftID > 0 {
					<input type="hidden" name="draft_id" value={ fmt.Sprintf("%d", d.DraftID) }/>
				}
				if d.ErrText != "" {
					<p class="error" role="alert">{ d.ErrText }</p>
				}
				<section class="compose-section">
					<div class="section-label">{ Tr(lang, "compose.rcpt") }</div>
					<div class="compose-rcpt-grid">
						<label>{ Tr(lang, "compose.to") }<input type="text" name="to" id="f-to" value={ d.To } placeholder="user@example.com"/></label>
						<label>{ Tr(lang, "compose.cc") }<input type="text" name="cc" id="f-cc" value={ d.Cc }/></label>
						<label>{ Tr(lang, "compose.bcc") }<input type="text" name="bcc" id="f-bcc" value={ d.Bcc }/></label>
					</div>
					<details>
						<summary>{ Tr(lang, "compose.csvImport") }</summary>
						<div class="actions">
							<input type="file" id="csv-file" accept=".csv,text/csv"/>
							<select id="csv-target">
								<option value="f-to">{ Tr(lang, "compose.to") }</option>
								<option value="f-cc">{ Tr(lang, "compose.cc") }</option>
								<option value="f-bcc">{ Tr(lang, "compose.bcc") }</option>
							</select>
							<button class="secondary" type="button" onclick="grmailCsvImport()">{ Tr(lang, "compose.csvParse") }</button>
						</div>
						<div id="csv-result"></div>
					</details>
					if d.IsAdmin {
						<label>{ Tr(lang, "compose.from") }<input type="text" name="from" value={ d.From } placeholder={ Tr(lang, "compose.fromPh") }/></label>
					}
				</section>
				<section class="compose-section">
					<div class="section-label">{ Tr(lang, "compose.subject") }</div>
					<label><input type="text" name="subject" value={ d.Subject } placeholder={ Tr(lang, "compose.subjectPh") }/></label>
				</section>
				<section class="compose-section">
					<div class="section-label">
						<span>{ Tr(lang, "compose.body") }</span>
						<span class="tool-spacer"></span>
						<button class="secondary btn-sm" type="button" id="fullscreen-btn" onclick="grmailComposeFullscreen()"
							data-enter={ Tr(lang, "compose.fullscreen") }
							data-exit={ Tr(lang, "compose.exitFullscreen") }>{ Tr(lang, "compose.fullscreen") }</button>
					</div>
					<input type="hidden" name="body" id="f-body" value=""/>
					<div id="compose-toolbar">
							<button type="button" class="ql-bold" title={ Tr(lang, "compose.tb.bold") }></button>
							<button type="button" class="ql-italic" title={ Tr(lang, "compose.tb.italic") }></button>
							<button type="button" class="ql-underline" title={ Tr(lang, "compose.tb.underline") }></button>
							<button type="button" class="ql-strike" title={ Tr(lang, "compose.tb.strike") }></button>
							<select class="ql-color" title={ Tr(lang, "compose.tb.color") }>
								<option value=""></option>
								<option value="#000000"></option>
								<option value="#374151"></option>
								<option value="#9ca3af"></option>
								<option value="#ffffff"></option>
								<option value="#dc2626"></option>
								<option value="#ea580c"></option>
								<option value="#d97706"></option>
								<option value="#16a34a"></option>
								<option value="#0d9488"></option>
								<option value="#2563eb"></option>
								<option value="#7c3aed"></option>
								<option value="#db2777"></option>
							</select>
							<select class="ql-background" title={ Tr(lang, "compose.tb.background") }>
								<option value=""></option>
								<option value="#000000"></option>
								<option value="#374151"></option>
								<option value="#9ca3af"></option>
								<option value="#ffffff"></option>
								<option value="#dc2626"></option>
								<option value="#ea580c"></option>
								<option value="#d97706"></option>
								<option value="#16a34a"></option>
								<option value="#0d9488"></option>
								<option value="#2563eb"></option>
								<option value="#7c3aed"></option>
								<option value="#db2777"></option>
							</select>
							<select class="ql-size" title={ Tr(lang, "compose.tb.size") }>
								<option value="small">{ Tr(lang, "compose.tb.sizeSmall") }</option>
								<option value="" selected="selected">{ Tr(lang, "compose.tb.sizeNormal") }</option>
								<option value="large">{ Tr(lang, "compose.tb.sizeLarge") }</option>
								<option value="huge">{ Tr(lang, "compose.tb.sizeHuge") }</option>
							</select>
							<select class="ql-font" title={ Tr(lang, "compose.tb.font") }>
								<option value="" selected="selected">{ Tr(lang, "compose.tb.fontDefault") }</option>
								<option value="serif">{ Tr(lang, "compose.tb.fontSerif") }</option>
								<option value="monospace">{ Tr(lang, "compose.tb.fontMono") }</option>
							</select>
							<select class="ql-header" title={ Tr(lang, "compose.tb.h1") }>
								<option value="1">{ Tr(lang, "compose.tb.h1") }</option>
								<option value="2">{ Tr(lang, "compose.tb.h2") }</option>
								<option value="" selected="selected">{ Tr(lang, "compose.tb.headerNormal") }</option>
							</select>
							<button type="button" class="ql-blockquote" title={ Tr(lang, "compose.tb.blockquote") }></button>
							<button type="button" class="ql-code-block" title={ Tr(lang, "compose.tb.codeBlock") }></button>
							<button type="button" class="ql-table" title={ Tr(lang, "compose.tb.table") }></button>
							<button type="button" class="ql-list" value="ordered" title={ Tr(lang, "compose.tb.listOrdered") }></button>
							<button type="button" class="ql-list" value="bullet" title={ Tr(lang, "compose.tb.listBullet") }></button>
							<button type="button" class="ql-align" value="" title={ Tr(lang, "compose.tb.alignLeft") }></button>
							<button type="button" class="ql-align" value="center" title={ Tr(lang, "compose.tb.alignCenter") }></button>
							<button type="button" class="ql-align" value="right" title={ Tr(lang, "compose.tb.alignRight") }></button>
							<button type="button" class="ql-align" value="justify" title={ Tr(lang, "compose.tb.alignJustify") }></button>
							<button type="button" class="ql-indent" value="-1" title={ Tr(lang, "compose.tb.indentLess") }></button>
							<button type="button" class="ql-indent" value="+1" title={ Tr(lang, "compose.tb.indentMore") }></button>
							<button type="button" class="ql-undo" title={ Tr(lang, "compose.tb.undo") }></button>
							<button type="button" class="ql-redo" title={ Tr(lang, "compose.tb.redo") }></button>
							<button type="button" class="ql-link" title={ Tr(lang, "compose.tb.link") }></button>
							<button type="button" class="ql-image" title={ Tr(lang, "compose.tb.image") }></button>
							<button type="button" class="ql-clean" title={ Tr(lang, "compose.tb.clean") }></button>
						</div>
					<div class="compose-editor" id="editor-container"></div>
					<textarea id="editor-initial" hidden>{ d.Body }</textarea>
				</section>
				<section class="compose-section">
					<div class="section-label">{ Tr(lang, "compose.attach") }</div>
					<label><input type="file" name="attachments" multiple="multiple"/></label>
				</section>
				<div class="compose-actions">
					<button class="primary" type="submit" name="action" value="send">{ Tr(lang, "compose.send") }</button>
					<button class="secondary" type="submit" name="action" value="save_draft">{ Tr(lang, "compose.saveDraft") }</button>
					<span class="spacer"></span>
					<a class="btn-text" href="/">{ Tr(lang, "common.cancel") }</a>
				</div>
			</form>
			<link rel="stylesheet" href="/static/quill.snow.css"/>
			<script src="/static/quill.js"></script>
			<script>
				// ── U17 富文本编辑器（G3/G4/G9——零框架内联 JS，沿 CSV 先例）──
				// 初始化：snow 主题+自定义 toolbar 容器（模板渲染双语 title）；
				// 初始内容经隐藏 textarea 携带（HTML 源文本）——dangerouslyPasteHTML
				// 注入（自产内容：草稿回填/回信预填，接收侧 iframe sandbox 既有防线）。
				let grmailEditor = null;
				// U22 图片压缩工程常量（计划书 1.5③——实现级常量非 config 承载：
				// 最长边重采样上限/JPEG 质量档——D8#11：config 注入（compose-page
				// data-* 承载——改 config.json 热加载后下次渲染生效；缺省兜底 1920/0.85）
				const GRMAIL_IMG_MAX_EDGE = parseInt(document.getElementById('compose-page').dataset.imgMaxEdge) || 1920;
				const GRMAIL_JPEG_QUALITY = parseFloat(document.getElementById('compose-page').dataset.jpegQuality) || 0.85;
				function grmailEditorInit() {
					if (typeof Quill === 'undefined') { return; }
					grmailEditor = new Quill('#editor-container', {
						theme: 'snow',
						modules: {
							toolbar: {
									container: '#compose-toolbar',
									handlers: {
										// U22：undo/redo 无 toolbar 内置按钮（源码核对
										// 零 ql-undo/ql-redo 注册）——经 history 模块
										// （内置）两行桥接
										undo: function() { this.quill.history.undo(); },
										redo: function() { this.quill.history.redo(); },
										// E-B（D8#13）：表格插入——Quill 2.0.3 内置 table
										// 模块（insertTable/行操作 API——vendor 源码实证）
										// 工具栏化激活：固定 2×2 起步（计划书 2.3-2 候选 A
										// 最小面自决；单元格编辑经 contenteditable 既有承载）
										table: function() { this.quill.getModule('table').insertTable(2, 2); }
									}
								},
								// E-B：table 模块显式启用（snow 主题下幂等——注册形态
								// 与 vendor 内置一致，显式声明消除主题默认差异）
								table: true,
							// U22 图片统一压缩接线（源码核对：工具栏选择/粘贴 files/
							// 拖放三路径全部汇聚 uploader.upload→options.handler——
							// 一处覆盖全入口；mimetypes 扩展 png/jpeg/gif/webp 与
							// image/* 等价，svg 排除——data: 内联脚本面收敛）
							uploader: {
								mimetypes: ['image/png', 'image/jpeg', 'image/gif', 'image/webp'],
								handler: grmailUploaderHandler
							}
						}
					});
					const initial = document.getElementById('editor-initial').value;
					if (initial && initial.trim() !== '') {
						grmailEditor.clipboard.dangerouslyPasteHTML(initial);
					}
				}
				// Blob/File → data: URL（FileReader 原语——压缩输出与原样兜底共用）。
				function grmailReadAsDataURL(blob) {
					return new Promise(resolve => {
						const reader = new FileReader();
						reader.onload = () => resolve(reader.result);
						reader.onerror = () => resolve('');
						reader.readAsDataURL(blob);
					});
				}
				// U22 图片压缩纯函数（Canvas 最长边重采样——缓解 base64 膨胀收口 U19
				// 登记项③）：①非 image/* 或解码失败：原样返回（尽力语义）；②最长边
				// ≤1920：原样零重采样（G9 小图保真）；③最长边 >1920：等比缩放至 1920
				// ——PNG 输入保 PNG（透明通道无损口径），其余输出 JPEG quality 0.85。
				async function grmailCompressImage(file) {
					if (!file.type || !file.type.startsWith('image/')) { return grmailReadAsDataURL(file); }
					// D8#14：gif 跳过压缩——Canvas 重采样会静默丢失动画（单帧化），
					// 原样内联保真（U22 登记项收口：动图保动画）
					if (file.type === 'image/gif') { return grmailReadAsDataURL(file); }
					let bmp = null;
					try { bmp = await createImageBitmap(file); } catch (e) { bmp = null; }
					if (bmp && Math.max(bmp.width, bmp.height) > GRMAIL_IMG_MAX_EDGE) {
						const scale = GRMAIL_IMG_MAX_EDGE / Math.max(bmp.width, bmp.height);
						const w = Math.max(1, Math.round(bmp.width * scale));
						const h = Math.max(1, Math.round(bmp.height * scale));
						const canvas = document.createElement('canvas');
						canvas.width = w;
						canvas.height = h;
						canvas.getContext('2d').drawImage(bmp, 0, 0, w, h);
						const type = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
						const out = await new Promise(r => canvas.toBlob(r, type, GRMAIL_JPEG_QUALITY));
						if (bmp.close) { bmp.close(); }
						if (out) { return grmailReadAsDataURL(out); }
					}
					if (bmp && bmp.close) { bmp.close(); }
					return grmailReadAsDataURL(file);
				}
				// U22 uploader 模块自定义 handler——默认 readAsDataURL 直插语义的压缩版
				// 复刻（逐图压缩→顺序 insertEmbed→光标后移；G9 data: 内联形态不变）。
				function grmailUploaderHandler(range, files) {
					const uploads = Array.from(files).map(f => grmailCompressImage(f));
					Promise.all(uploads).then(urls => {
						urls.forEach(u => {
							if (u) { grmailEditor.insertEmbed(range.index, 'image', u); }
						});
						grmailEditor.setSelection(range.index + urls.length);
					});
				}
				// 提交桥接：编辑器容器非表单原生控件——submit 前将 root.innerHTML
				// 写入隐藏 input body（随表单 POST——端点形态零变更）。
				function grmailComposeSync() {
					if (grmailEditor) {
						document.getElementById('f-body').value = grmailEditor.root.innerHTML;
					}
					return true;
				}
				// G4 写信页全屏覆写：整页容器（含收件人/主题/附件区）requestFullscreen
				// /exitFullscreen 切换（Fullscreen API 原生——纯 JS 零库；ESC 系统默认退出）。
				function grmailComposeFullscreen() {
					const page = document.getElementById('compose-page');
					const btn = document.getElementById('fullscreen-btn');
					if (!document.fullscreenElement) {
						page.requestFullscreen().then(() => {
							btn.textContent = btn.getAttribute('data-exit');
						}).catch(() => {});
					} else {
						document.exitFullscreen().then(() => {
							btn.textContent = btn.getAttribute('data-enter');
						}).catch(() => {});
					}
				}
				// E-A（D8#10）：macOS 平台快捷键提示 ⌘ 记法自适应——U19「统一 Ctrl 记法
				// 不分支」口径的平台面收口（Quill shortKey 内部已平台自适应——本函数仅
				// 提示文案层；服务端渲染 title 保持 Ctrl 记法初值〔u17/u22 断言锚零触碰〕，
				// Mac 客户端加载后改写为 ⌘ 记法；navigator.platform 与 Quill 源码同源口径）。
				function grmailAdaptShortcutTitles() {
					if (!/Mac|iPhone|iPad/.test(navigator.platform || '')) { return; }
					document.querySelectorAll('#compose-toolbar button[title*="(Ctrl+"]').forEach(function (btn) {
						btn.title = btn.title.replace(/\(Ctrl\+([A-Z])\)/g, '(⌘$1)');
					});
				}
				grmailEditorInit();
				grmailAdaptShortcutTitles();
				// ── CSV 候选合入（U16 Q5-A 既有——勾选行地址合并进所选 to/cc/bcc 输入框）──
				function grmailCsvImport() {
					const f = document.getElementById('csv-file').files[0];
					if (!f) { return; }
					const fd = new FormData();
					fd.append('csrf_token', document.querySelector('input[name=csrf_token]').value);
					fd.append('file', f);
					fetch('/compose/csv-import', { method: 'POST', body: fd })
						.then(r => r.ok ? r.text() : Promise.reject(r.status))
						.then(html => {
							document.getElementById('csv-result').innerHTML = html;
						})
						.catch(() => {
							var pageEl = document.getElementById('compose-page');
							var csvErr = pageEl && pageEl.dataset ? pageEl.dataset.csvErr : '';
							document.getElementById('csv-result').innerHTML = '<p class="error">' + (csvErr || 'CSV parse failed') + '</p>';
						});
				}
				function grmailCsvMerge() {
					const target = document.getElementById('csv-target').value;
					const boxes = document.querySelectorAll('#csv-result input.csv-addr:checked');
					const addrs = Array.from(boxes).map(b => b.value);
					if (addrs.length === 0) { return; }
					const el = document.getElementById(target);
					const cur = el.value.trim();
					const merged = cur ? cur + ', ' + addrs.join(', ') : addrs.join(', ');
					el.value = merged;
				}
			</script>
		</div>
	}
}
