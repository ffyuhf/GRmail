// GRmail 改密表单页（Webmail管理职能批次 G1——D1 缺陷收口；双通道共用视图：
// mailbox 主体 /settings/password·admin 主体 /admin/password——Action 字段分派）。
// admin 形态多 username 字段（verifyAdmin 链输入——单管理员输入成本可接受，零 storage 增量）。
// 依据：Webmail管理职能计划书 v1.0.0 1.2 G1（G2 批准 2026-10-05 15:15:22）；SRS FR-001/002/013。
// 修改历史：
//
//	2026-10-05 15:20:00 | 新建 | Webmail管理职能批次（计划书阶段 2）
package templates

// PasswordData 改密表单页数据（视图模型——沿 sieve.templ 结构随模板承载先例）。
type PasswordData struct {
	Lang      string // 界面语言（U18 深级双语承载）
	CSRFToken string // 会话绑定 CSRF token（U8 csrfProtect 校验）
	Action    string // 表单提交目标（/settings/password | /admin/password——主体分派）
	IsAdmin   bool   // admin 形态标记（多 username 字段）
	Username  string // admin 用户名回填（错误重渲染不丢输入）
	ErrText   string // 操作错误提示（空=无）
	Nav       *MailListData // 全站侧栏数据（D3 B 形态——AppFrame 承载；nil=无邮箱异常态降级）
}

// PasswordView 改密表单页（旧密码+新密码+确认三段；提交后由 handler 会话重建+重定向）。
// 参数：d 表单数据。
templ PasswordView(d *PasswordData) {
	{{ lang := NormalizeLang(d.Lang) }}
	@AppFrame(lang, Tr(lang, "pw.title"), Tr(lang, "pw.title"), d.IsAdmin, d.CSRFToken, d.Nav) {
		<div class="main content-page">
			<nav class="settings-nav"><a href="/settings">{ Tr(lang, "nav.backSettings") }</a></nav>
			<div class="page-head"><h2>{ Tr(lang, "pw.title") }</h2></div>
			<div class="card form-card">
				<form method="post" action={ templ.SafeURL(d.Action) }>
					<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>
					if d.ErrText != "" {
						<p class="error" role="alert">{ d.ErrText }</p>
					}
					if d.IsAdmin {
						<label>{ Tr(lang, "pw.user") }<input type="text" name="username" value={ d.Username } autocomplete="username" required maxlength="64"/></label>
					}
					<label>{ Tr(lang, "pw.old") }<input type="password" name="oldPassword" autocomplete="current-password" required/></label>
					<label>{ Tr(lang, "pw.new") }<input type="password" name="newPassword" autocomplete="new-password" required minlength="8"/></label>
					<label>{ Tr(lang, "pw.confirm") }<input type="password" name="confirmPassword" autocomplete="new-password" required minlength="8"/></label>
					<p class="hint">{ Tr(lang, "pw.hint") }</p>
					<button class="primary" type="submit">{ Tr(lang, "pw.submit") }</button>
				</form>
			</div>
		</div>
	}
}
