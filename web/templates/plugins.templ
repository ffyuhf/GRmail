// GRmail 插件只读状态页（Webmail管理职能批次 G6——D7 缺陷收口；S3-W Q3-A 裁决：
// 只读呈现零进程管理扩展）。列：名称/版本/能力声明/运行状态（崩溃摘除态如实呈现——
// Q3-A 不重拉语义的运维可视面）；空态引导（放置插件二进制后重启生效）。
// 依据：Webmail管理职能计划书 v1.0.0 1.2 G6（G2 批准 2026-10-05 15:15:22）；SRS FR-016。
// 修改历史：
//
//	2026-10-05 15:20:00 | 新建 | Webmail管理职能批次（计划书阶段 6）
package templates

// PluginRow 插件状态呈现行（templates 侧视图模型——与 web.PluginStatus 字段同构；
// web→templates 单向依赖，桥接转换在 web/plugins.go handler 内完成）。
type PluginRow struct {
	Name    string
	Version string
	Caps    []string
	Alive   bool
}

// PluginsData 插件状态页数据（视图模型）。
type PluginsData struct {
	Nav *MailListData // 全站侧栏数据（D3 B 形态——AppFrame 承载；nil=无邮箱异常态降级）
	Lang    string       // 界面语言
	Plugins []PluginRow  // 状态行集（web 桥接转换后注入）
}

// PluginsView 插件状态页（admin 主体——AppLayout admin 形态）。
// 参数：d 页面数据。
templ PluginsView(d PluginsData) {
	{{ lang := NormalizeLang(d.Lang) }}
	@AppFrame(lang, Tr(lang, "plugins.title"), Tr(lang, "home.adminKind"), true, "", d.Nav) {
		<div class="main content-page">
			<nav class="settings-nav"><a href="/admin/settings">{ Tr(lang, "nav.backSettings") }</a></nav>
			<div class="page-head"><h2>{ Tr(lang, "plugins.title") }</h2></div>
			<p class="hint">{ Tr(lang, "plugins.hint") }</p>
			if len(d.Plugins) == 0 {
				<div class="empty-state">
					<h3>{ Tr(lang, "plugins.emptyTitle") }</h3>
					<p>{ Tr(lang, "plugins.empty") }</p>
				</div>
			} else {
				<div class="table-wrap">
					<table class="mails">
						<thead><tr>
							<th>{ Tr(lang, "plugins.colName") }</th>
							<th>{ Tr(lang, "plugins.colVer") }</th>
							<th>{ Tr(lang, "plugins.colCaps") }</th>
							<th>{ Tr(lang, "plugins.colStatus") }</th>
						</tr></thead>
						<tbody>
							for _, p := range d.Plugins {
								<tr>
									<td>{ p.Name }</td>
									<td>{ p.Version }</td>
									<td>
										if len(p.Caps) == 0 {
											<span class="hint">—</span>
										} else {
											for _, c := range p.Caps {
												<span class="chip">{ c }</span>
											}
										}
									</td>
									<td>
										if p.Alive {
											<span class="badge active">{ Tr(lang, "plugins.alive") }</span>
										} else {
											<span class="badge disabled">{ Tr(lang, "plugins.dead") }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
