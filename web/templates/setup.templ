// GRmail Setup 六步向导页（U10：FR-015/NFR-010——Q3-A 80 明文承载不携会话；
// 步骤序沿手册第 1 章：库→密码→域名→DNS→SSL→完成；U18 深级双语收口——U16 登记项③：
// 六步全量文案 Tr 化——向导无会话但 cookie lang 可读（语言偏好先于认证承载，/lang 先例））。
// 修改历史：
//   2026-09-20 01:25:00 | 新建 | U10 Setup 向导与 ACME（计划书步骤 6）
//   2026-09-26 15:54:00 | 扩展 | U18 登记项收尾：深级文案 Tr 化（setup 域键+步骤导航
//   双语化——缺省 zh 渲染与 U17 末态零变化锚）
//   （依据：U18 计划书 v1.0.0 步骤 3/1.5④，G2 批准 2026-09-26 15:25:47）
//   2026-10-04 15:07:00 | 修正 | 向导占位符与布局修复批次：①步 3 增 DKIM 密钥生成区
//   （强度四档 select+重新生成勾选+已生成提示——裁决一a/三a；setupPostDomain 生成链
//   消费侧）②删 3 处输入框 placeholder 示例文本（DSN/域名/ACME 邮箱——干系人指令
//   「把站位符给去掉」12:01；填写指引由 label 文案承载）③删 5 处 size 属性
//   （36/48 物理宽超卡片内容宽顶破边框——布局错乱根因②；配合 app.css 满宽规则）
//   （依据：向导占位符与布局修复计划书 v1.0.0 1.2-CLR/DKIM 组，G2 批准 2026-10-04
//   15:03:25）
//   2026-10-05 00:22:00 | 修正 | Setup向导缺陷修复批次：①卡片挂 card setup-card 双类
//   （缺陷②——自适应宽度：fit-content 内容自适应+视口封顶+窄步下限，DNS 四列表格
//   舒展；干系人裁决「我要求是自适应」2026-10-05 00:18）②语言切换链接传
//   data.LangNext（缺陷④b——/lang?next= 当前步回跳）
//   （依据：Setup向导缺陷修复计划书 v1.0.0 1.2 组2/组4b，G2 批准 2026-10-05 00:21:19）
//   2026-10-05 01:56:00 | 重构 | Setup向导新手可用性批次（P1~P13 十三项）：①步骤条
//   （P1——卡片顶部 steps-bar 六节点：完成勾/当前亮/未来灰，替代底部弱文字导航）
//   ②每步 desc 说明段+步 1 欢迎段（P2）③步 5 端口警示条（P3——HTTPPort≠80）+DNS-01
//   等待期说明（P7）④DSN 双模式（P11——分字段五参/高级直填，:has() 纯 CSS 互斥切换）
//   ⑤DNS 表 TTL 列（P8）⑥完成页重写（P13——访问/登录/重启指引+ACME 等待期+端口用途
//   表+客户端参数表+details 技术细节折叠区；P5 就绪自检以等待期文案承载——零新端点）
//   ⑦步 2 已设置态徽标（P6——HadAdmin 禁用呈现）
//   （依据：Setup向导新手可用性计划书 v1.0.0 1.2 P1~P13 组，G2 批准 2026-10-05
//   01:27:29；参考对照 PMail 前端 SetupView；白话+细节分层原则——零信息丢失）
package templates

// SetupView 向导步骤页（六步共用组件按 Step 分支渲染；当前值回填支持部分完成态恢复）。
// 参数：data 步骤数据（SetupData——web 包 buildSetupData 装配；Lang 承载界面语言）。
templ SetupView(data SetupData) {
	{{ lang := NormalizeLang(data.Lang) }}
	@Layout(lang, Tr(lang, "setup.title"), data.Error) {
		<div class="card setup-card">
		<h1>{ Trf(lang, "setup.h1", data.Step, data.Total, data.Title) }</h1>
		// P1 步骤条：六节点 SSR 静态呈现（完成勾/当前亮/未来灰——纯 CSS 零 JS）。
		<ol class="steps-bar" aria-label={ Tr(lang, "setup.stepsNav") }>
			{{ titles := setupStepTitles(lang) }}
			for i, s := range titles {
				if i+1 < data.Step {
					<li class="done"><span class="dot">✓</span><span class="lbl">{ s }</span></li>
				} else if i+1 == data.Step {
					<li class="cur"><span class="dot">{ strconvItoa(i + 1) }</span><span class="lbl">{ s }</span></li>
				} else {
					<li><span class="dot">{ strconvItoa(i + 1) }</span><span class="lbl">{ s }</span></li>
				}
			}
		</ol>
		if data.Step == 1 {
			// P2 欢迎段（首步呈现——开场引导+已有配置恢复指引）。
			<section class="setup-welcome">
				<h2>{ Tr(lang, "setup.welcome") }</h2>
				<p>{ Tr(lang, "setup.welcomeDesc") }</p>
			</section>
			<p class="desc">{ Tr(lang, "setup.desc1") }</p>
			<form method="post" action="/setup/database">
				<fieldset>
					<legend>{ Tr(lang, "setup.s1Legend") } <small class="ref">{ Tr(lang, "setup.s1Ref") }</small></legend>
					<label><input type="radio" name="driver" value="sqlite" { checkedAttrs(data.Driver == "sqlite" || data.Driver == "")... }/> { Tr(lang, "setup.sqlite") }</label>
					<label><input type="radio" name="driver" value="mysql" { checkedAttrs(data.Driver == "mysql")... }/> MySQL</label>
					<label><input type="radio" name="driver" value="postgres" { checkedAttrs(data.Driver == "postgres")... }/> PostgreSQL</label>
					// P11 DSN 双模式：分字段（推荐）/高级直填互斥（:has() 纯 CSS 切换——
					// 零 JS；sqlite 选中时整个连接区隐藏）。
					<div class="dsn-area">
						<p class="dsn-mode">
							<label><input type="radio" name="dsnMode" value="basic" checked/> { Tr(lang, "setup.dsnModeBasic") }</label>
							<label><input type="radio" name="dsnMode" value="advanced"/> { Tr(lang, "setup.dsnModeAdvanced") }</label>
						</p>
						<div class="dsn-basic">
							<label>{ Tr(lang, "setup.dsnHost") } <input type="text" name="dbHost" value={ data.DSNHost } maxlength="255"/></label>
							<label>{ Tr(lang, "setup.dsnPort") }{ Tr(lang, "setup.dsnPortM") }) <input type="text" name="dbPort" value={ data.DSNPort } maxlength="5" inputmode="numeric"/></label>
							<label>{ Tr(lang, "setup.dsnUser") } <input type="text" name="dbUser" value={ data.DSNUser } maxlength="128"/></label>
							<label>{ Tr(lang, "setup.dsnPassword") } <input type="password" name="dbPassword" autocomplete="new-password"/></label>
							<label>{ Tr(lang, "setup.dsnDBName") } <input type="text" name="dbName" value={ data.DSNDBName } maxlength="128"/></label>
						</div>
						<div class="dsn-advanced">
							<label>{ Tr(lang, "setup.dsn") } <input type="text" name="dsn" value={ data.DSN }/></label>
						</div>
					</div>
					<label class="sqlite-only">{ Tr(lang, "setup.dsn") } <input type="text" name="sqlitePath" value={ data.DSN }/></label>
				</fieldset>
				<p class="hint">{ Tr(lang, "setup.s1Hint") }</p>
				<button class="primary" type="submit">{ Tr(lang, "setup.next") }</button>
			</form>
		}
		if data.Step == 2 {
			<p class="desc">{ Tr(lang, "setup.desc2") }</p>
			if data.HadAdmin {
				// P6 已设置态徽标（预填名命中——skip 路径既有保持）。
				<p class="notice">{ Tr(lang, "setup.adminExists") }</p>
			}
			<form method="post" action="/setup/admin">
				<fieldset>
					<legend>{ Tr(lang, "setup.s2Legend") } <small class="ref">{ Tr(lang, "setup.s2Ref") }</small></legend>
					<label>{ Tr(lang, "login.username") } <input type="text" name="username" value={ data.Username } required maxlength="64" { disabledAttrs(data.HadAdmin)... }/></label>
					<label>{ Tr(lang, "login.password") } <input type="password" name="password" { disabledAttrs(data.HadAdmin)... }/></label>
					<label>{ Tr(lang, "setup.confirm") } <input type="password" name="confirm" { disabledAttrs(data.HadAdmin)... }/></label>
				</fieldset>
				<button class="primary" type="submit" { disabledAttrs(data.HadAdmin)... }>{ Tr(lang, "setup.createGo") }</button>
			</form>
			<form method="post" action="/setup/admin">
				<input type="hidden" name="action" value="skip"/>
				<p class="hint">{ Tr(lang, "setup.s2Hint") }<button type="submit" class="linklike">{ Tr(lang, "setup.skip") }</button></p>
			</form>
		}
		if data.Step == 3 {
			<p class="desc">{ Tr(lang, "setup.desc3") }</p>
			<form method="post" action="/setup/domain">
				<fieldset>
					<legend>{ Tr(lang, "setup.s3Legend") }</legend>
					<label>{ Tr(lang, "setup.domain") } <input type="text" name="domain" value={ data.Domain } required maxlength="255"/></label>
				</fieldset>
				<fieldset>
					<legend>{ Tr(lang, "setup.dkimLegend") }</legend>
					<label>{ Tr(lang, "setup.dkimStrength") }
						<select name="dkimStrength">
							<option value="rsa-2048" { selectedAttrs(data.DKIMStrength != "rsa-3072" && data.DKIMStrength != "rsa-4096" && data.DKIMStrength != "ed25519")... }>RSA 2048</option>
							<option value="rsa-3072" { selectedAttrs(data.DKIMStrength == "rsa-3072")... }>RSA 3072</option>
							<option value="rsa-4096" { selectedAttrs(data.DKIMStrength == "rsa-4096")... }>RSA 4096</option>
							<option value="ed25519" { selectedAttrs(data.DKIMStrength == "ed25519")... }>Ed25519</option>
						</select>
					</label>
					<label><input type="checkbox" name="dkimRegen"/> { Tr(lang, "setup.dkimRegen") }</label>
					if data.DKIMGenerated {
						<p class="hint">{ Tr(lang, "setup.dkimExisting") }</p>
					}
				</fieldset>
				<button class="primary" type="submit">{ Tr(lang, "setup.next") }</button>
			</form>
		}
		if data.Step == 4 {
			<p class="desc">{ Tr(lang, "setup.desc4") }</p>
			<form method="post" action="/setup/dns">
				<fieldset>
					<legend>{ Tr(lang, "setup.s4Legend") }</legend>
					<div class="table-wrap">
						<table>
							<tr><th>{ Tr(lang, "setup.colType") }</th><th>{ Tr(lang, "setup.colHost") }</th><th>{ Tr(lang, "setup.colValue") }</th><th>{ Tr(lang, "setup.colTTL") }</th><th>{ Tr(lang, "setup.colNote") }</th></tr>
							for _, r := range data.DNSRecords {
								<tr><td>{ r.Type }</td><td>{ r.Name }</td><td><code>{ r.Value }</code></td><td>{ r.TTL }</td><td>{ r.Note }</td></tr>
							}
						</table>
					</div>
				</fieldset>
				<button class="primary" type="submit">{ Tr(lang, "setup.dnsDone") }</button>
			</form>
		}
		if data.Step == 5 {
			<p class="desc">{ Tr(lang, "setup.desc5") }</p>
			if data.HTTPPort != 80 {
				// P3 端口前置警告（-p 覆盖场景——含行动指引；呈现于证书模式选择前）。
				<p class="error" role="alert"><strong>{ Tr(lang, "setup.portWarnTitle") }</strong>（: { strconvItoa(data.HTTPPort) }）——{ Tr(lang, "setup.portWarnBody") }</p>
			}
			<form method="post" action="/setup/ssl">
				<fieldset>
					<legend>{ Tr(lang, "setup.s5Legend") } <small class="ref">{ Tr(lang, "setup.s5Ref") }</small></legend>
					<label><input type="radio" name="mode" value="acme" { checkedAttrs(data.SSLMode != "manual")... }/> { Tr(lang, "setup.acme") }</label>
					<label>{ Tr(lang, "setup.acmeMail") } <input type="text" name="acmeEmail" value={ data.ACMEMail }/></label>
					<label><input type="checkbox" name="acmeStaging" { checkedAttrs(data.ACMEStaging)... }/> { Tr(lang, "setup.staging") }</label>
					<label><input type="radio" name="acmeChallenge" value="http" { checkedAttrs(data.ACMEChallenge != "dns")... }/> { Tr(lang, "setup.http01") }</label>
					<label><input type="radio" name="acmeChallenge" value="dns" { checkedAttrs(data.ACMEChallenge == "dns")... }/> { Tr(lang, "setup.dns01") }</label>
					// P7 DNS-01 等待期预期说明（选择 DNS 验证时——静态呈现于选项下方）。
					<p class="hint">{ Tr(lang, "setup.dnsWaitHint") }</p>
					<label>{ Tr(lang, "setup.dnsToken") } <input type="password" name="acmeDnsToken" autocomplete="off"/></label>
					<hr/>
					<label><input type="radio" name="mode" value="manual" { checkedAttrs(data.SSLMode == "manual")... }/> { Tr(lang, "setup.manual") }</label>
					<label>{ Tr(lang, "setup.certFile") } <input type="text" name="certFile" value={ data.CertFile }/></label>
					<label>{ Tr(lang, "setup.keyFile") } <input type="text" name="keyFile" value={ data.KeyFile }/></label>
				</fieldset>
				<button class="primary" type="submit">{ Tr(lang, "setup.next") }</button>
			</form>
		}
		if data.Step == 6 {
			// P13 完成页重写：白话指引三块（访问/登录/重启）+ACME 等待期+端口用途表+
			// 客户端参数表+details 技术细节折叠区（零信息丢失——细节降级呈现）。
			<p class="desc">{ Tr(lang, "setup.desc6") }</p>
			<form method="post" action="/setup/done">
				<fieldset>
					<legend>{ Tr(lang, "setup.s6Legend") }</legend>
					<p class="desc">{ Tr(lang, "setup.s6Intro") }</p>
					<ul class="setup-summary">
						<li>{ Tr(lang, "setup.s6Domain") }<code>{ data.DomainFinal }</code></li>
						<li><strong>{ Tr(lang, "setup.restartTitle") }</strong>——{ Tr(lang, "setup.s6Restart") }</li>
						<li>{ Tr(lang, "setup.visitTitle") }：{ Tr(lang, "setup.visitDesc") } <code>https://{ data.DomainFinal }</code></li>
						<li><strong>{ Tr(lang, "setup.loginTitle") }</strong>——{ Tr(lang, "setup.loginAdmin") }</li>
						<li><strong>{ Tr(lang, "setup.acmeWaitTitle") }</strong>——{ Tr(lang, "setup.acmeWaitDesc") }（{ Tr(lang, "setup.s6Acme") }）</li>
					</ul>
				</fieldset>
				<fieldset>
					<legend>{ Tr(lang, "setup.portLegend") }</legend>
					<ul class="port-list">
						<li><code>25</code> { Tr(lang, "setup.port25") }</li>
						<li><code>465</code> { Tr(lang, "setup.port465") }</li>
						<li><code>587</code> { Tr(lang, "setup.port587") }</li>
						<li><code>993</code> { Tr(lang, "setup.port993") }</li>
						<li><code>995</code> { Tr(lang, "setup.port995") }</li>
						<li><code>443</code> { Tr(lang, "setup.port443") }</li>
					</ul>
				</fieldset>
				<fieldset>
					<legend>{ Tr(lang, "setup.clientLegend") }</legend>
					<div class="table-wrap">
						<table>
							<tr><th>{ Tr(lang, "setup.clientIMAP") }</th><td><code>imap.{ data.DomainFinal }</code> : 993（{ Tr(lang, "setup.clientSSL") }）</td></tr>
							<tr><th>{ Tr(lang, "setup.clientPOP3") }</th><td><code>pop.{ data.DomainFinal }</code> : 995（{ Tr(lang, "setup.clientSSL") }）</td></tr>
							<tr><th>{ Tr(lang, "setup.clientSMTP") }</th><td><code>smtp.{ data.DomainFinal }</code> : 465（{ Tr(lang, "setup.clientSSL") }）/ 587（{ Tr(lang, "setup.clientStartTLS") }）</td></tr>
							<tr><th>{ Tr(lang, "setup.clientWebmail") }</th><td><code>https://{ data.DomainFinal }</code></td></tr>
						</table>
					</div>
				</fieldset>
				// P10 技术细节折叠区（<details> 纯 HTML——细节保留、按需展开）。
				<details class="tech-details">
					<summary>{ Tr(lang, "setup.techDetails") }</summary>
					<p>{ Tr(lang, "setup.techCompleted") }</p>
				</details>
				<button class="primary" type="submit">{ Tr(lang, "setup.finish") }</button>
			</form>
		}
		<p class="hint lang-switch"><a href={ langSwitchHref(lang, data.LangNext) }>{ Tr(lang, "top.lang") }</a></p>
		</div>
	}
}

// setupStepTitles 步骤标题清单（步骤条+导航渲染源——与 web.setupSteps 同序，模板侧独立
// 承载避免跨包引用；U18 双语化——lang 参数注入；strconvItoa/strconvItoa64 定义于
// settings.templ 同包共用）。
func setupStepTitles(lang Lang) []string {
	return []string{
		Tr(lang, "setup.stepDB"),
		Tr(lang, "setup.stepAdmin"),
		Tr(lang, "setup.stepDomain"),
		Tr(lang, "setup.stepDNS"),
		Tr(lang, "setup.stepSSL"),
		Tr(lang, "setup.stepDone"),
	}
}
