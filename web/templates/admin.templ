// GRmail Web admin 邮箱管理与聚合视图页（U9，Q3-C 归属；U18 深级双语收口——U16 登记项③）。
// FR-002 管理呈现（三态徽标+五操作）；FR-003 shadow 聚合视图。
// Webmail管理职能批次 G4 重构（D4 缺陷收口）：增强表格——2FA 绑定/强制态列+创建时间列+
// 地址即时过滤（纯前端子串匹配——单管理员规模零后端增量）+active 行内改密（G1 setpassword
// action 消费）+行详情展开（邮箱 ID/2FA 明细——details 原生承载零 JS）。
// 修改历史：
//   2026-09-19 15:16:00 | 新建 | U9 Webmail 核心（计划书步骤 10）
//   2026-09-26 15:41:00 | 扩展 | U18 登记项收尾：深级文案 Tr 化（lang 首参贯通+
//   admin 域键消费——缺省 zh 渲染与 U17 末态零变化锚）
//   （依据：U18 计划书 v1.0.0 步骤 3/1.5④，G2 批准 2026-09-26 15:25:47）
//   2026-10-01 17:10:00 | 扩展 | U24 双因素认证：管理页增「2FA 强制策略」操作区
//   （require2fa/unrequire2fa 两 action——FR-018 判定④；Q3-B 强制标记承载面）
//   2026-10-05 15:25:00 | 重构 | Webmail管理职能批次 G4：AdminMailboxRow 增强行
//   （2FA 态/创建时间列+搜索过滤+行内改密+详情展开——计划书 1.2 G4，G2 批准
//   2026-10-05 15:15:22）
//   2026-10-14 20:45:00 | 修正 | Webmail前端可用性收口批 B2/E-1-A：签名增 noticeText
//   参数+成功反馈呈现块（G2 批准 2026-10-14 20:37 E-1-A noticed 303 扩展）
//   2026-10-15 01:35:00 | 修正 | Webmail前端可选交互增强批 C3/E-2-A：两视图 settings-nav
//   内联替换为 settingsNavBack 组件（呈现零变化锚——aria-label 既有形态保持）
//   （依据：γ批计划书 v1.0.0 1.2 C3，G2 批准 2026-10-15 01:22 候选 E-2-A）
package templates

import (
	"fmt"
	"strings"
)

// AdminMailboxRow 管理列表增强行（视图模型——Webmail管理职能批次 G4）。
type AdminMailboxRow struct {
	Address       string // 邮箱地址（小写规范化）
	Status        string // active / shadow / disabled
	CreatedAt     string // 创建日期（YYYY-MM-DD 呈现态）
	MailboxID     int64  // 邮箱 ID（详情行呈现）
	TwoFABound    bool   // 2FA 绑定态（Bound()=密钥与恢复码同时非空）
	TwoFARequired bool   // 管理员强制标记
	TwoFAKnown    bool   // 2FA 态可知（TwoFactor 未注入/查询故障=false→呈现未知）
}

// statusLabel 状态枚举双语映射（F09——badge 呈现层；类锚保持英文枚举——Webmail界面精修批次）。
func statusLabel(lang Lang, status string) string {
	switch status {
	case "active":
		return Tr(lang, "admin.statusActive")
	case "shadow":
		return Tr(lang, "admin.statusShadow")
	case "disabled":
		return Tr(lang, "admin.statusDisabled")
	}
	return status
}

// twoFALabel 2FA 态列标签（G4——绑定/未绑定+强制角标；未知态呈现 —）。
func twoFALabel(lang Lang, r *AdminMailboxRow) string {
	if !r.TwoFAKnown {
		return "—"
	}
	if r.TwoFABound {
		return Tr(lang, "admin.tfBound")
	}
	if r.TwoFARequired {
		return Tr(lang, "admin.tfUnboundReq")
	}
	return Tr(lang, "admin.tfNone")
}

// AdminMailboxesView 邮箱管理页（增强列表+操作表单组——G4 形态）。
// 参数：lang 界面语言；rows 增强行集；errText 操作结果提示；noticeText 成功反馈文案
//（B2/E-1-A α 批——noticed 303 回带 ?noted= 经 GET 装配注入）；csrf 会话 token。
// D3（2026-10-05 B 形态）：nav 参数为全站侧栏数据（AppFrame 承载；nil=无邮箱异常态降级）。
templ AdminMailboxesView(lang Lang, rows []*AdminMailboxRow, errText string, noticeText string, csrf string, nav *MailListData) {
	@AppFrame(lang, Tr(lang, "admin.title"), Tr(lang, "home.adminKind"), true, csrf, nav) {
		<main class="main content-page" id="main-content">
			@settingsNavBack(lang, true)
			<div class="page-head">
				<h2>{ Tr(lang, "admin.h2") }（{ fmt.Sprintf("%d", len(rows)) }）</h2>
				// C4（批五）：状态筛选/地址过滤补 aria-label（原 placeholder/option 文案弱关联——
				// 读屏控件名直达；新键 admin.filterStatus/admin.filterAddr）。
				<select id="admin-status-filter" class="filter-input" aria-label={ Tr(lang, "admin.filterStatus") }>
					<option value="">{ Tr(lang, "mail.colStatus") }：{ Tr(lang, "admin.filterAll") }</option>
					<option value="active">{ Tr(lang, "admin.statusActive") }</option>
					<option value="shadow">{ Tr(lang, "admin.statusShadow") }</option>
					<option value="disabled">{ Tr(lang, "admin.statusDisabled") }</option>
				</select>
				<input type="search" id="admin-filter" class="filter-input"
					placeholder={ Tr(lang, "admin.searchPh") } aria-label={ Tr(lang, "admin.filterAddr") } autocomplete="off"/>
			</div>
			if errText != "" {
				<p class="error" role="alert">{ errText }</p>
			}
			// B2/E-1-A（α 批）：管理操作成功反馈（noticed 303 回带——原成功静默无文字反馈收口）。
			if noticeText != "" {
				<p class="notice" role="status">{ noticeText }</p>
			}
			<div class="table-wrap admin-table-wrap">
				// B11（批五）：th scope=col 补齐+sr-only caption（读屏表头关联与表用途播报——
				// 视觉零变化；对照 mail_list.templ 既有形态）。
				<table class="mails admin-mailboxes">
					<caption class="sr-only">{ Tr(lang, "admin.h2") }</caption>
					<thead><tr>
						<th scope="col">{ Tr(lang, "admin.colAddr") }</th>
						<th scope="col">{ Tr(lang, "mail.colStatus") }</th>
						<th scope="col">2FA</th>
						<th scope="col">{ Tr(lang, "admin.colCreated") }</th>
						<th scope="col">{ Tr(lang, "admin.colAction") }</th>
					</tr></thead>
					<tbody id="admin-rows">
						for _, m := range rows {
							<tr data-addr={ strings.ToLower(m.Address) } data-status={ m.Status }>
								<td>
									<details class="row-details">
										<summary>{ m.Address }</summary>
										<div class="row-details-body">
											// E5（批二）：行详情标签 Tr 化（原 ID:/2FA: 英文裸标签）。
											<p>{ Tr(lang, "admin.detID") }{ colonFor(lang) }{ fmt.Sprintf("%d", m.MailboxID) }</p>
											<p>{ Tr(lang, "admin.det2FA") }{ colonFor(lang) }{ twoFALabel(lang, m) }{ twoFAExtra(lang, m) }</p>
											<p>{ Tr(lang, "admin.colCreated") }{ colonFor(lang) }{ m.CreatedAt }</p>
										</div>
									</details>
								</td>
								<td><span class={ "badge", m.Status }>{ statusLabel(lang, m.Status) }</span></td>
								<td>{ twoFALabel(lang, m) }{ twoFAExtra(lang, m) }</td>
								<td>{ m.CreatedAt }</td>
								<td>
									<form method="post" action="/admin/mailboxes" class="inline">
										<input type="hidden" name="csrf_token" value={ csrf }/>
										<input type="hidden" name="address" value={ m.Address }/>
										if m.Status == "disabled" {
											<button class="btn-sm" type="submit" name="action" value="enable">{ Tr(lang, "admin.enable") }</button>
										} else if m.Status == "active" {
											<button class="btn-sm secondary" type="submit" name="action" value="disable">{ Tr(lang, "admin.disable") }</button>
										} else if m.Status == "shadow" {
											<input type="password" name="password" aria-label={ Tr(lang, "admin.setPass") } autocomplete="new-password" minlength="8" placeholder={ Tr(lang, "admin.setPass") }/>
											<button class="btn-sm" type="submit" name="action" value="activate">{ Tr(lang, "admin.activate") }</button>
										}
									</form>
									if m.Status == "active" || m.Status == "disabled" {
										<form method="post" action="/admin/mailboxes" class="inline">
											<input type="hidden" name="csrf_token" value={ csrf }/>
											<input type="hidden" name="address" value={ m.Address }/>
											<input type="password" name="password" aria-label={ Tr(lang, "admin.setPwd") } autocomplete="new-password" minlength="8" placeholder={ Tr(lang, "admin.newPassPh") }/>
											<button class="btn-sm" type="submit" name="action" value="setpassword">{ Tr(lang, "admin.setPwd") }</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
				// C10（批二）+B8（批五）：过滤零行空态（rows 非空但过滤无匹配——grmail.js
				// grmailApplyAdminFilter 联动显隐 #admin-empty 本批真实落码；rows 全空服务端
				// 直达呈现）。B8①：空态文案专用键 admin.emptyMailboxes（原错用聚合视图键
				// admin.aggEmptyTitle——语义错位收口）。
				if len(rows) == 0 {
					<div class="empty-state" id="admin-empty"><h3>{ Tr(lang, "mail.emptyTitle") }</h3><p>{ Tr(lang, "admin.emptyMailboxes") }</p></div>
				} else {
					<div class="empty-state" id="admin-empty" hidden><h3>{ Tr(lang, "mail.emptyTitle") }</h3><p>{ Tr(lang, "admin.emptyMailboxes") }</p></div>
				}
			</div>
			<h3>{ Tr(lang, "admin.createMailbox") }</h3>
			<form method="post" action="/admin/mailboxes" class="actions">
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="text" name="address" aria-label={ Tr(lang, "admin.createMailbox") } inputmode="email" autocapitalize="none" spellcheck="false" placeholder={ Tr(lang, "admin.addrPh") }/>
				<input type="password" name="password" aria-label={ Tr(lang, "admin.passPh") } autocomplete="new-password" minlength="8" placeholder={ Tr(lang, "admin.passPh") }/>
				<button class="primary" type="submit" name="action" value="create">{ Tr(lang, "common.create") }</button>
			</form>
			<h3>{ Tr(lang, "admin.2faSection") }</h3>
			<form method="post" action="/admin/mailboxes" class="actions">
				<input type="hidden" name="csrf_token" value={ csrf }/>
				// C4（批五）：2FA 强制策略地址输入补 aria-label（复用既有键——原 placeholder 弱关联）。
				<input type="text" name="address" required maxlength="320" aria-label={ Tr(lang, "admin.2faAddr") } placeholder={ Tr(lang, "admin.2faAddr") }/>
				<button class="secondary" type="submit" name="action" value="require2fa">{ Tr(lang, "admin.require2fa") }</button>
				<button class="secondary" type="submit" name="action" value="unrequire2fa">{ Tr(lang, "admin.unrequire2fa") }</button>
			</form>
			</main>
		}
	}
	
	// twoFAExtra 2FA 强制角标（绑定+强制并存时补注——G4 列呈现完整语义；
	// E6 批二：括号经 colonFor 同语言标点——全角硬编码在英文界面残留收口）。
	func twoFAExtra(lang Lang, r *AdminMailboxRow) string {
		if r.TwoFAKnown && r.TwoFARequired {
			return parenFor(lang, Tr(lang, "admin.tfRequiredMark"))
		}
		return ""
	}
	
	// parenFor 全角/半角括号（E6——zh「（）」/en"()"；tfRequiredMark/twoFAExtra 承载）。
	func parenFor(lang Lang, s string) string {
		if lang == LangEN {
			return "(" + s + ")"
		}
		return "（" + s + "）"
	}

// AdminUnregisteredView catch-all 聚合视图（FR-003：shadow 邮箱巡览）。
// 参数：lang 界面语言（U18）；list shadow 邮箱列表；csrf 会话 token。
// D3（2026-10-05 B 形态）：nav 同 AdminMailboxesView。
templ AdminUnregisteredView(lang Lang, list []*AdminMailboxRow, csrf string, nav *MailListData) {
	@AppFrame(lang, Tr(lang, "admin.aggTitle"), Tr(lang, "home.adminKind"), true, csrf, nav) {
		// B10（批五）：main 地标+id 补齐（skip-link 跳转目标——批二 G1 实施不完整收尾；
		// 对照 AdminMailboxesView 既有形态）。
		<main class="main content-page" id="main-content">
			@settingsNavBack(lang, true)
			<div class="page-head"><h2>{ Tr(lang, "admin.aggH2") }</h2></div>
			if len(list) == 0 {
				<div class="empty-state">
					<h3>{ Tr(lang, "admin.aggEmptyTitle") }</h3>
					<p>{ Tr(lang, "admin.aggEmpty") }</p>
				</div>
			} else {
				<div class="table-wrap">
					// B11（批五）：聚合视图表同款 scope+caption。
					<table class="mails">
						<caption class="sr-only">{ Tr(lang, "admin.aggH2") }</caption>
						<thead><tr><th scope="col">{ Tr(lang, "admin.colAddr") }</th><th scope="col">{ Tr(lang, "mail.colStatus") }</th><th scope="col">{ Tr(lang, "admin.aggArchived") }</th></tr></thead>
						<tbody>
							for _, m := range list {
								<tr>
									<td>{ m.Address }</td>
									<td><span class={ "badge", m.Status }>{ statusLabel(lang, m.Status) }</span></td>
									<td>{ fmt.Sprintf(Tr(lang, "admin.shadowFmt"), m.MailboxID) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</main>
		}
	}
